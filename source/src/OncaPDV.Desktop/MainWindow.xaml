<Window x:Class="OncaPDV.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ONÇA PDV PRO 0.3.0 — Frente de caixa profissional"
        Height="768" Width="1366" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6F4"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/>
                <ResourceDictionary Source="ProfessionalTheme0200.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CheckoutMethodButton" TargetType="Button" BasedOn="{StaticResource ProSecondaryButton}">
                <Setter Property="MinHeight" Value="54"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="3"/>
            </Style>
            <Style x:Key="MiniActionButton" TargetType="Button" BasedOn="{StaticResource ProSecondaryButton}">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="2"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F3F6F4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="184"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="PaymentColumn" Width="310"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="84"/>
        </Grid.RowDefinitions>

        <!-- Navegação: operação separada de gestão e sistema -->
        <Border Grid.Column="0" Grid.RowSpan="3" Background="White" BorderBrush="#DDE5E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition/><RowDefinition Height="78"/></Grid.RowDefinitions>
                <StackPanel Margin="20,17,14,8">
                    <TextBlock Text="ONÇA" FontSize="27" FontWeight="Bold" Foreground="#0B6B3A"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PDV PRO" FontSize="17" FontWeight="Bold" Foreground="#26342E"/>
                        <Border Background="#E9F5ED" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="0.3.0" FontSize="10" FontWeight="Bold" Foreground="#0B6B3A"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Onça Produtos de Limpeza" FontSize="11" Foreground="#7A8780" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,3,0,10">
                        <TextBlock Text="OPERAÇÃO" FontSize="10" FontWeight="Bold" Foreground="#96A19B" Margin="20,8,0,5"/>
                        <Button Style="{StaticResource ProNavActiveButton}" Content="Frente de Caixa"/>
                        <Button Style="{StaticResource ProNavButton}" Content="Caixa" Click="Operations_Click"/>
                        <Button Style="{StaticResource ProNavButton}" Content="Crediário" Click="Credit_Click"/>
                        <Button Style="{StaticResource ProNavButton}" Content="Produtos" Click="Product_Click"/>
                        <Button Style="{StaticResource ProNavButton}" Content="Diversos" Click="Diversos_Click" ToolTip="Item avulso sem cadastro — F4"/>
                        <Button Style="{StaticResource ProNavButton}" Content="Estoque" Click="Inventory026_Click"/>
                        <Button Style="{StaticResource ProNavButton}" Content="Clientes" Click="CustomerManagement_Click"/>

                        <Expander Header="GESTÃO" IsExpanded="True" Margin="8,12,8,0" Foreground="#65736C" FontWeight="Bold">
                            <StackPanel Margin="0,4,0,0">
                                <Button Style="{StaticResource ProNavButton}" Content="Compras e fornecedores" Click="Purchases_Click"/>
                                <Button Style="{StaticResource ProNavButton}" Content="Financeiro / contas a pagar" Click="Finance052_Click"/>
                                <Button Style="{StaticResource ProNavButton}" Content="Vendas e pós-venda" Click="ManageSales_Click"/>
                                <Button Style="{StaticResource ProNavButton}" Content="Relatórios" Click="Reports022_Click"/>
                                <Button Style="{StaticResource ProNavButton}" Content="Orçamentos e documentos" Click="Documents_Click"/>
                                <Button Style="{StaticResource ProNavButton}" Content="Pedidos" Click="Orders_Click"/>
                                <Button Style="{StaticResource ProNavButton}" Content="Trocas / devoluções / despesas" Click="FinalOps_Click"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="SISTEMA" IsExpanded="False" Margin="8,10,8,0" Foreground="#65736C" FontWeight="Bold">
                            <StackPanel Margin="0,4,0,0">
                                <Button Style="{StaticResource ProNavButton}" Content="Centro de Integridade" Click="Integrity151_Click"/>
                                <Button Style="{StaticResource ProNavButton}" Content="Diagnóstico técnico" Click="Diagnostic_Click"/>
                                <Button Style="{StaticResource ProNavButton}" Content="Backup" Click="BackupCenter_Click"/>
                                <Button Style="{StaticResource ProNavButton}" Content="Tela / tamanho" Click="DisplaySettings_Click"/>
                                <Button Style="{StaticResource ProNavButton}" Content="Impressora" Click="Printer_Click"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#F1F7F3" CornerRadius="10" Padding="11" Margin="12,7,12,12">
                    <StackPanel>
                        <TextBlock Text="Operação protegida" FontSize="11" FontWeight="Bold" Foreground="#0B6B3A"/>
                        <TextBlock Text="Venda, estoque e caixa integrados" FontSize="10" Foreground="#6C7A73" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Cabeçalho operacional -->
        <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Background="White" BorderBrush="#DDE5E0" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentSaleText" Text="Frente de Caixa" FontSize="19" FontWeight="Bold" Foreground="#17231D"/>
                    <TextBlock x:Name="SessionText" Text="Consultando estado do caixa..." FontSize="11" Foreground="#76827C"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Border Background="#FFF5E6" CornerRadius="7" Padding="9,5" Margin="3,0"><TextBlock x:Name="LastBackupText" Text="Backup: verificar" Foreground="#9A6200" FontSize="11" FontWeight="SemiBold"/></Border>
                    <Border Background="#EAF8EF" CornerRadius="7" Padding="9,5" Margin="3,0"><TextBlock x:Name="HealthText" Text="SISTEMA: verificando" Foreground="#087233" FontSize="11" FontWeight="Bold"/></Border>
                    <Button Style="{StaticResource ProSecondaryButton}" Content="TELA CHEIA  [F11]" Padding="9,5" MinHeight="30" Margin="3,0" Click="ToggleFocusMode_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="ClockText" FontSize="13" FontWeight="SemiBold" Foreground="#39463F" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="SaleToastBorder" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Panel.ZIndex="20" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0B6B3A" CornerRadius="10" Padding="22,10">
            <TextBlock x:Name="SaleToastText" Foreground="White" FontSize="15" FontWeight="Bold"/>
        </Border>

        <!-- Área central: busca, carrinho e histórico rápido -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="10,10,5,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="SalesHistoryRow" Height="40"/></Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Border Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                            <WrapPanel x:Name="MultiSaleTabsPanel" VerticalAlignment="Center"/>
                        </ScrollViewer>
                        <Button Grid.Column="1" Style="{StaticResource ProPrimaryButton}" Content="+ NOVA" ToolTip="Nova venda — Ctrl+N" Padding="13,8" Margin="8,0,0,0" Click="NewMultiSale_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource ProSecondaryButton}" Content="RENOMEAR" Padding="11,8" Margin="6,0,0,0" Click="RenameMultiSale040_Click"/>
                        <Button Grid.Column="3" Style="{StaticResource ProDangerButton}" Content="FECHAR ABA" Padding="11,8" Margin="6,0,0,0" Click="CloseMultiSale_Click"/>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="#CFE0D6" BorderThickness="1" CornerRadius="11" Padding="8" Margin="0,0,0,9">
                    <StackPanel><TabControl x:Name="ProductEntryTabs" SelectedIndex="0" Background="Transparent" BorderThickness="0" FontWeight="SemiBold">
                        <TabItem Header="PRODUTOS / SCANNER" Padding="16,7">
                            <Grid Margin="4,7,4,3">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="CÓDIGO OU NOME • quantidade: 3*código ou 3xcódigo" FontSize="11" Foreground="#65736C" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SearchBox" Style="{StaticResource ProTextBox}" FontSize="24" Padding="8,5" KeyDown="SearchBox_KeyDown" AutomationProperties.Name="Scanner"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ProPrimaryButton}" Content="ADICIONAR  ↵" Margin="8,18,0,0" Click="Add_Click"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="DIVERSOS  [F4]" Padding="16,7">
                            <Grid Margin="4,9,4,3">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="68"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="DESCRIÇÃO DO ITEM" FontSize="10" FontWeight="Bold" Foreground="#7C8982" Margin="2,0,0,3"/>
                                        <TextBox x:Name="DiversosNameBox" Style="{StaticResource ProTextBox}" FontSize="17" ToolTip="Nome ou descrição do item"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                        <TextBlock Text="VALOR UNITÁRIO" FontSize="10" FontWeight="Bold" Foreground="#7C8982" Margin="2,0,0,3"/>
                                        <TextBox x:Name="DiversosValueBox" Style="{StaticResource ProTextBox}" FontSize="17" ToolTip="Valor unitário em R$"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                        <TextBlock Text="QTD" FontSize="10" FontWeight="Bold" Foreground="#7C8982" Margin="2,0,0,3"/>
                                        <TextBox x:Name="DiversosQtyBox" Style="{StaticResource ProTextBox}" FontSize="17" Text="1" ToolTip="Quantidade"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource ProPrimaryButton}" Content="ADICIONAR" Margin="4,18,0,0" MinWidth="115" Click="InlineDiversosAdd_Click"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="2,7,2,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Item avulso sem cadastro." FontSize="11" Foreground="#77847D" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource ProSecondaryButton}" Content="ABRIR TELA DIVERSOS" Padding="10,5" MinHeight="30" Click="Diversos_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <Border x:Name="StockAlertBorder" Visibility="Collapsed" Background="#FFF4E5" BorderBrush="#F0C36A" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="4,4,4,0">
                        <TextBlock x:Name="StockAlertText" Foreground="#925B00" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
                    </Border></StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="11" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition/><RowDefinition Height="46"/></Grid.RowDefinitions>
                    <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="CARRINHO" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MiniActionButton}" Content="−" Tag="-1" Click="AdjustQuantity030_Click" ToolTip="Diminuir quantidade"/>
                            <Button Style="{StaticResource MiniActionButton}" Content="+" Tag="1" Click="AdjustQuantity030_Click" ToolTip="Aumentar quantidade"/>
                            <Button Style="{StaticResource MiniActionButton}" Content="ALTERAR QTD" Click="EditQuantity030_Click"/>
                            <Button Style="{StaticResource MiniActionButton}" Content="REMOVER" Click="RemoveSelected030_Click" Foreground="#B42318"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="CartGrid" Style="{StaticResource ProDataGrid}" ColumnHeaderStyle="{StaticResource ProDataGridHeader}" AutoGenerateColumns="False" CellEditEnding="CartGrid_CellEditEnding" Margin="10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Code}" IsReadOnly="True" Visibility="Collapsed" Width="75"/>
                            <DataGridTextColumn Header="PRODUTO" Binding="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Code}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="QTD" Binding="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Width="78"/>
                            <DataGridTextColumn Header="UNITÁRIO" Binding="{Binding UnitPrice,UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding Subtotal,StringFormat=N2}" IsReadOnly="True" Width="90"/>
                            <DataGridTemplateColumn Header="" Width="68">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource ProDangerButton}" Content="REMOVER" Padding="7,3" FontSize="9" Tag="{Binding Index}" Click="RemoveCartItem_Click" ToolTip="Remover item"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="12,3">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ProDangerButton}" Content="CANCELAR [ESC]" Click="Cancel_Click" HorizontalAlignment="Left" Padding="11,6" MinHeight="34"/>
                        <Button Grid.Column="1" Style="{StaticResource ProSecondaryButton}" Content="SEPARAR PEDIDO" Click="SeparateOrder030_Click" Padding="11,6" MinHeight="34"/>
                        <Button Grid.Column="2" Style="{StaticResource ProSecondaryButton}" Content="CUPOM" Click="Preview_Click" Padding="11,6" MinHeight="34" Margin="6,0,0,0"/>
                        <Button Grid.Column="3" Style="{StaticResource ProSecondaryButton}" Content="ORÇAMENTO" Click="SaveQuote_Click" Padding="11,6" MinHeight="34" Margin="6,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="LastSalesBorder" Grid.Row="2" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="11">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Últimas vendas" FontSize="15" FontWeight="Bold" Foreground="#27342E" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource MiniActionButton}" Content="MOSTRAR / RECOLHER" Click="ToggleHistory030_Click"/>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="SalesGrid" Visibility="Collapsed" Style="{StaticResource ProDataGrid}" ColumnHeaderStyle="{StaticResource ProDataGridHeader}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="32" FontSize="12" Margin="10,0,10,7">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VENDA" Binding="{Binding Number,StringFormat=000000}" Width="85"/>
                            <DataGridTextColumn Header="DATA / HORA" Binding="{Binding CreatedAt,StringFormat=dd/MM HH:mm}" Width="115"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding Total,StringFormat=C}" Width="90"/>
                            <DataGridTemplateColumn Header="AÇÕES" Width="*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MiniActionButton}" Content="VER" Tag="{Binding Id}" Click="ViewSale_Click"/>
                                    <Button Style="{StaticResource MiniActionButton}" Content="REIMPRIMIR" Tag="{Binding Id}" Click="Reprint_Click"/>
                                    <Button Style="{StaticResource MiniActionButton}" Content="PDF" Tag="{Binding Id}" Click="SalePdf_Click"/>
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Resumo fixo: finalizar e cliente sempre visíveis. -->
        <Grid Grid.Column="2" Grid.Row="1" Margin="5,10,10,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="White" CornerRadius="10" Padding="12" BorderBrush="#DDE5E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CLIENTE DA VENDA" Style="{StaticResource ProLabel}"/>
                    <TextBlock x:Name="CustomerText" Text="CONSUMIDOR" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,5"/>
                    <WrapPanel>
                        <Button Style="{StaticResource MiniActionButton}" Content="SELECIONAR [F3]" Click="Customer_Click"/>
                        <Button Style="{StaticResource MiniActionButton}" Content="LIMPAR" Click="RemoveCustomer_Click"/>
                        <Button Style="{StaticResource MiniActionButton}" Content="HISTÓRICO" Click="CustomerHistoryQuick_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="CustomerPulseText" FontSize="11" Foreground="#52615A" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12" Margin="0,8" BorderBrush="#DDE5E0" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource MiniActionButton}" Content="RESUMO DO CAIXA / FECHAMENTO" Click="Operations_Click"/>
                    <TextBlock x:Name="CashPulseText" Text="Atualizando..." TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Background="#0B6B3A" CornerRadius="10" Padding="15">
                <StackPanel>
                    <TextBlock x:Name="SubtotalText" Foreground="#DDF2E4" FontSize="12"/>
                    <TextBlock x:Name="DiscountText" Foreground="#DDF2E4" FontSize="12" Visibility="Collapsed"/>
                    <TextBlock Text="TOTAL" Foreground="White" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock x:Name="TotalText" Text="R$ 0,00" FontSize="42" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="3" x:Name="PaymentPanel" Margin="0,8,0,0">
                <Button x:Name="FinalizeButton030" Style="{StaticResource ProPrimaryButton}" Content="FINALIZAR VENDA — F9" FontSize="17" MinHeight="58" Click="Pay_Click"/>
                <TextBlock Text="Escolha o pagamento ao finalizar" HorizontalAlignment="Center" Foreground="#65736C" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Background="White" BorderBrush="#DDE5E0" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <UniformGrid Columns="8">
                    <Button Style="{StaticResource MiniActionButton}" Content="PRODUTO [F2]" Click="Product_Click"/>
                    <Button Style="{StaticResource MiniActionButton}" Content="CLIENTE [F3]" Click="Customer_Click"/>
                    <Button Style="{StaticResource MiniActionButton}" Content="DIVERSOS [F4]" Click="Diversos_Click"/>
                    <Button Style="{StaticResource MiniActionButton}" Click="QuickPriceScanner_Click"><TextBlock Text="CONSULTA PREÇO&#10;F5" TextAlignment="Center"/></Button>
                    <Button Style="{StaticResource MiniActionButton}" Click="HoldSale_Click"><TextBlock Text="COLOCAR EM ESPERA&#10;F6" TextAlignment="Center"/></Button>
                    <Button Style="{StaticResource MiniActionButton}" Click="FinalOps_Click"><TextBlock x:Name="HoldCountText" Text="RECUPERAR [F7]" TextAlignment="Center"/></Button>
                    <Button Style="{StaticResource MiniActionButton}" Click="LastSale030_Click"><TextBlock Text="ÚLTIMA VENDA&#10;F8" TextAlignment="Center"/></Button>
                    <Button Style="{StaticResource MiniActionButton}" Content="CALCULADORA" Click="Calculator_Click"/>
                </UniformGrid>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="SCANNER PRONTO" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#0B6B3A" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="RecoveryText" FontSize="9" Foreground="#65736C"/><TextBlock x:Name="DatabaseStatus" FontSize="9" Foreground="#65736C"/></StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
