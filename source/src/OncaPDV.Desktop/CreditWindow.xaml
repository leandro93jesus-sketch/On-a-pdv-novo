<Window x:Class="OncaPDV.Desktop.CreditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:OncaPDV.Domain;assembly=OncaPDV.Domain"
        Title="Crediário — ONÇA PDV PRO 0.2.3"
        Width="1380" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6F4"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/>
                <ResourceDictionary Source="ProfessionalTheme0200.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CreditStatusBadge" TargetType="Border">
                <Setter Property="Background" Value="#EEF2EF"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Crediário" FontSize="27" FontWeight="Bold" Foreground="#17231D"/>
                <TextBlock Text="Cobrança diária separada de histórico e ações administrativas." Foreground="#6F7C75" FontSize="13" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E9F5ED" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                <TextBlock x:Name="ActiveFilterText" Text="Filtro: ATIVOS" Foreground="#0B6B3A" FontSize="12" FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- Indicadores -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,15,0,12">
            <Border Background="White" BorderBrush="#E3D7D5" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                <StackPanel><TextBlock Text="A RECEBER" Style="{StaticResource ProLabel}"/><TextBlock x:Name="TotalOpenText" Text="R$ 0,00" FontSize="25" FontWeight="Bold" Foreground="#B42318" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D6E7DA" BorderThickness="1" CornerRadius="10" Padding="14" Margin="3,0,6,0">
                <StackPanel><TextBlock Text="RECEBIDO" Style="{StaticResource ProLabel}"/><TextBlock x:Name="TotalPaidText" Text="R$ 0,00" FontSize="25" FontWeight="Bold" Foreground="#0B6B3A" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#F0DDC5" BorderThickness="1" CornerRadius="10" Padding="14" Margin="3,0,6,0">
                <StackPanel><TextBlock Text="VENCIDOS" Style="{StaticResource ProLabel}"/><TextBlock x:Name="OverdueText" Text="0" FontSize="25" FontWeight="Bold" Foreground="#B46900" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D6E1F4" BorderThickness="1" CornerRadius="10" Padding="14" Margin="3,0,0,0">
                <StackPanel><TextBlock Text="CONTAS NO FILTRO" Style="{StaticResource ProLabel}"/><TextBlock x:Name="AccountsCountText" Text="0" FontSize="25" FontWeight="Bold" Foreground="#175CD3" Margin="0,3,0,0"/></StackPanel>
            </Border>
        </UniformGrid>

        <!-- Busca e filtros -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,11">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BUSCAR CLIENTE" Style="{StaticResource ProLabel}" Margin="2,0,0,3"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource ProTextBox}" TextChanged="Search_Changed" ToolTip="Buscar cliente por nome"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="VISUALIZAÇÃO" Style="{StaticResource ProLabel}" Margin="3,0,0,3"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ProFilterButton}" Content="ATIVOS" Tag="Todos" Click="FilterButton_Click"/>
                        <Button Style="{StaticResource ProFilterButton}" Content="VENCIDOS" Tag="Overdue" Click="FilterButton_Click"/>
                        <Button Style="{StaticResource ProFilterButton}" Content="PAGOS" Tag="Paid" Click="FilterButton_Click"/>
                        <Expander Header="MAIS FILTROS" Margin="6,2,0,0" VerticalAlignment="Center">
                            <Border Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="8" Padding="7" Margin="0,4,0,0">
                                <WrapPanel>
                                    <Button Style="{StaticResource ProFilterButton}" Content="PARCIAL" Tag="Partial" Click="FilterButton_Click"/>
                                    <Button Style="{StaticResource ProFilterButton}" Content="EM ABERTO" Tag="Open" Click="FilterButton_Click"/>
                                    <Button Style="{StaticResource ProFilterButton}" Content="CANCELADOS" Tag="Cancelled" Click="FilterButton_Click"/>
                                    <Button Style="{StaticResource ProFilterButton}" Content="AUDITORIA" Click="Audit049_Click"/>
                                </WrapPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>

            <Grid Margin="0,0,11,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="188"/></Grid.RowDefinitions>

                <Expander Grid.Row="0" Header="Ações em lote" Foreground="#536159" FontWeight="SemiBold" Margin="0,0,0,7">
                    <Border Background="#F7FAF8" BorderBrush="#E0E7E3" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,5,0,0">
                        <WrapPanel>
                            <Button Style="{StaticResource ProSecondaryButton}" Content="MARCAR VISÍVEIS" Padding="11,7" MinHeight="34" Click="MarkAll048_Click"/>
                            <Button Style="{StaticResource ProSecondaryButton}" Content="LIMPAR" Padding="11,7" MinHeight="34" Margin="6,0,0,0" Click="ClearMarks048_Click"/>
                            <Button Style="{StaticResource ProDangerButton}" Content="RETIRAR MARCADAS DO CREDIÁRIO" Padding="11,7" MinHeight="34" Margin="6,0,0,0" Click="DeleteMarked048_Click"/>
                            <Border Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="8,0,0,0"><TextBlock x:Name="MarkedCount048" Text="0 marcadas" VerticalAlignment="Center" FontWeight="Bold" Foreground="#4D5B54"/></Border>
                        </WrapPanel>
                    </Border>
                </Expander>

                <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="7">
                    <DataGrid x:Name="Accounts" Style="{StaticResource ProDataGrid}" ColumnHeaderStyle="{StaticResource ProDataGridHeader}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Account_Changed">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsChecked="{Binding MarkedForBulk048,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="MarkChanged048_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding Customer}" Width="*"/>
                            <DataGridTextColumn Header="VENDA" Binding="{Binding SaleNumber,StringFormat=000000}" Width="82"/>
                            <DataGridTextColumn Header="SALDO" Binding="{Binding Balance,StringFormat=C}" Width="105"/>
                            <DataGridTextColumn Header="VENCIMENTO" Binding="{Binding DueAt,StringFormat=dd/MM/yyyy}" Width="105"/>
                            <DataGridTemplateColumn Header="STATUS" Width="106">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CreditStatusBadge}">
                                            <TextBlock x:Name="StatusText" Text="Em aberto" FontSize="11" FontWeight="Bold" Foreground="#45534C"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:CreditStatus.Partial}"><Setter TargetName="StatusText" Property="Text" Value="Parcial"/><Setter TargetName="StatusText" Property="Foreground" Value="#175CD3"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:CreditStatus.Overdue}"><Setter TargetName="StatusText" Property="Text" Value="Vencido"/><Setter TargetName="StatusText" Property="Foreground" Value="#B42318"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:CreditStatus.Paid}"><Setter TargetName="StatusText" Property="Text" Value="Pago"/><Setter TargetName="StatusText" Property="Foreground" Value="#0B6B3A"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:CreditStatus.Cancelled}"><Setter TargetName="StatusText" Property="Text" Value="Cancelado"/><Setter TargetName="StatusText" Property="Foreground" Value="#66736C"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="2" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,10,0,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Histórico de recebimentos da conta" FontSize="13" FontWeight="Bold" Foreground="#34423A" VerticalAlignment="Center" Margin="5,0"/>
                        <DataGrid Grid.Row="1" x:Name="Movements" Style="{StaticResource ProDataGrid}" ColumnHeaderStyle="{StaticResource ProDataGridHeader}" IsReadOnly="True" AutoGenerateColumns="False" RowHeight="32" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATA / HORA" Binding="{Binding CreatedAt,StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                                <DataGridTextColumn Header="FORMA" Binding="{Binding Method}" Width="110"/>
                                <DataGridTextColumn Header="VALOR" Binding="{Binding Amount,StringFormat=C}" Width="105"/>
                                <DataGridTextColumn Header="OBSERVAÇÃO" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Painel de contexto e ação principal -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="CONTA SELECIONADA" Style="{StaticResource ProLabel}"/>
                            <TextBlock x:Name="SelectedCustomerText" Text="Selecione uma conta" FontSize="21" FontWeight="Bold" Foreground="#17231D" Margin="0,7,0,1" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedSaleText" Text="Venda: —" Foreground="#78847E"/>
                            <Separator Margin="0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Valor original" Style="{StaticResource ProLabel}"/><TextBlock x:Name="SelectedOriginalText" Text="R$ 0,00" FontSize="18" FontWeight="SemiBold" Foreground="#27342E" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Total pago" Style="{StaticResource ProLabel}"/><TextBlock x:Name="SelectedPaidText" Text="R$ 0,00" FontSize="18" FontWeight="SemiBold" Foreground="#0B6B3A" Margin="0,3,0,0"/></StackPanel>
                            </Grid>
                            <Border Background="#FFF3F1" BorderBrush="#F3D4D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,10">
                                <StackPanel><TextBlock Text="SALDO EM ABERTO" FontSize="11" FontWeight="Bold" Foreground="#A13C32"/><TextBlock x:Name="SelectedBalanceText" Text="R$ 0,00" FontSize="32" FontWeight="Bold" Foreground="#B42318" TextAlignment="Right"/></StackPanel>
                            </Border>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Vencimento" Style="{StaticResource ProLabel}"/><TextBlock x:Name="SelectedDueText" Text="—" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Status" Style="{StaticResource ProLabel}"/><TextBlock x:Name="SelectedStatusText" Text="—" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#EAF6EE" BorderBrush="#D3E8D9" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Recebimento" FontSize="14" FontWeight="Bold" Foreground="#0B6B3A"/>
                            <TextBlock Text="Ação principal do crediário. Ao quitar, a conta sai de ATIVOS e permanece no histórico de PAGOS." TextWrapping="Wrap" Foreground="#5C6A63" FontSize="11" Margin="0,4,0,9"/>
                            <Button Style="{StaticResource ProPrimaryButton}" Content="RECEBER PAGAMENTO  [F9]" FontSize="16" MinHeight="50" Click="Receive_Click"/>
                            <UniformGrid Columns="2" Margin="0,7,0,0">
                                <Button Style="{StaticResource ProSecondaryButton}" Content="EXTRATO PDF" Click="Pdf_Click" Margin="3"/>
                                <Button Style="{StaticResource ProSecondaryButton}" Content="WHATSAPP" Click="WhatsApp_Click" Margin="3"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Expander Header="Ações administrativas" Foreground="#6A4F48" FontWeight="SemiBold">
                        <Border Background="#FBF8F7" BorderBrush="#E9DEDA" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,5,0,0">
                            <StackPanel>
                                <TextBlock Text="Use apenas para correção, estorno ou retirada administrativa. Essas ações ficam auditadas." TextWrapping="Wrap" Foreground="#796B65" FontSize="11" Margin="2,0,2,7"/>
                                <Button Style="{StaticResource ProSecondaryButton}" Content="EDITAR / CORRIGIR RECEBIMENTO" Click="EditReceipt_Click" Margin="0,2"/>
                                <Button Style="{StaticResource ProDangerButton}" Content="ESTORNAR RECEBIMENTO" Click="ReverseReceipt_Click" Margin="0,2"/>
                                <Button Style="{StaticResource ProDangerButton}" Content="RETIRAR CONTA DO CREDIÁRIO" Click="DeleteCredit046_Click" Margin="0,2"/>
                                <Button Style="{StaticResource ProSecondaryButton}" Content="CONFERIR RECEBIMENTOS / CAIXA" Click="CheckCreditCash046_Click" Margin="0,2"/>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="4" Margin="0,11,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="ATIVOS mostra apenas contas com saldo. PAGOS e AUDITORIA preservam o histórico sem poluir a cobrança diária." Foreground="#75827B" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource ProSecondaryButton}" Content="FECHAR" IsCancel="True" Width="110"/>
        </Grid>
    </Grid>
</Window>
