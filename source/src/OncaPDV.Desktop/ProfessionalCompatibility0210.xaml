<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ProfessionalTheme0200.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="Button" BasedOn="{StaticResource ProSecondaryButton}">
        <Setter Property="Margin" Value="3"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource ProTextBox}">
        <Setter Property="Margin" Value="3"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ProComboBox}">
        <Setter Property="Margin" Value="3"/>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource ProDataGrid}">
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ProDataGridHeader}"/>
        <Setter Property="Margin" Value="3"/>
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource ProTabItem}"/>
    <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ProText}"/>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ProText}"/>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource ProBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource ProText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="3"/>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource ProText}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
</ResourceDictionary>
