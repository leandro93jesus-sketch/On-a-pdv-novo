<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ProBg" Color="#F3F6F4"/>
    <SolidColorBrush x:Key="ProSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ProBorder" Color="#DDE5E0"/>
    <SolidColorBrush x:Key="ProText" Color="#17231D"/>
    <SolidColorBrush x:Key="ProMuted" Color="#6E7B74"/>
    <SolidColorBrush x:Key="ProPrimary" Color="#0B6B3A"/>
    <SolidColorBrush x:Key="ProPrimarySoft" Color="#E9F5ED"/>
    <SolidColorBrush x:Key="ProWarning" Color="#B46900"/>
    <SolidColorBrush x:Key="ProDanger" Color="#B42318"/>
    <SolidColorBrush x:Key="ProDangerSoft" Color="#FFF0EE"/>
    <SolidColorBrush x:Key="ProBlue" Color="#175CD3"/>

    <Style x:Key="ProPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ProPrimary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,10"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.90"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.78"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.42"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProSecondaryButton" TargetType="Button" BasedOn="{StaticResource ProPrimaryButton}">
        <Setter Property="Background" Value="#EEF2EF"/>
        <Setter Property="Foreground" Value="{StaticResource ProText}"/>
    </Style>

    <Style x:Key="ProDangerButton" TargetType="Button" BasedOn="{StaticResource ProPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource ProDangerSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource ProDanger}"/>
    </Style>

    <Style x:Key="ProNavButton" TargetType="Button" BasedOn="{StaticResource ProPrimaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#2C3A33"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="13,9"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Margin" Value="8,1"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="ProNavActiveButton" TargetType="Button" BasedOn="{StaticResource ProNavButton}">
        <Setter Property="Background" Value="{StaticResource ProPrimarySoft}"/>
        <Setter Property="Foreground" Value="{StaticResource ProPrimary}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="ProFilterButton" TargetType="Button" BasedOn="{StaticResource ProSecondaryButton}">
        <Setter Property="Padding" Value="13,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="86"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="ProTextBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource ProBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ProComboBox" TargetType="ComboBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource ProBorder}"/>
    </Style>

    <Style x:Key="ProDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E8EEEA"/>
        <Setter Property="VerticalGridLinesBrush" Value="#F7F9F8"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#FAFCFB"/>
        <Setter Property="RowHeight" Value="43"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>

    <Style x:Key="ProDataGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F2F5F3"/>
        <Setter Property="Foreground" Value="#45524C"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="#E3E9E5"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="ProTabItem" TargetType="TabItem">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Foreground" Value="#52615A"/>
    </Style>

    <Style x:Key="ProSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ProText}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="ProLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ProMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
