<Window x:Class="OncaPDV.Desktop.IntegrityCenter151Window"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Centro de Integridade — ONÇA PDV PRO 0.2.3" Width="1320" Height="820" MinWidth="1080" MinHeight="700"
 WindowStartupLocation="CenterOwner" Background="#F3F6F4" FontFamily="Segoe UI">
 <Window.Resources>
  <ResourceDictionary>
<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/>
                <ResourceDictionary Source="ProfessionalTheme0200.xaml"/>
            </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Centro de Integridade" FontSize="27" FontWeight="Bold" Foreground="#17231D"/>
    <TextBlock Text="Diagnóstico de banco, vendas, caixa, crediário e duplicidades. Nenhum dado é corrigido automaticamente." Foreground="#6F7C75" FontSize="13" Margin="0,3,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Style="{StaticResource ProSecondaryButton}" Content="ATUALIZAR" MinWidth="110" Margin="3" Click="Refresh_Click"/>
    <Button Style="{StaticResource ProPrimaryButton}" Content="EXPORTAR RELATÓRIO" MinWidth="150" Margin="3" Click="Export_Click"/>
   </StackPanel>
  </Grid>

  <Border Grid.Row="1" Margin="0,14,0,12" Padding="13" CornerRadius="10" Background="White" BorderBrush="#DDE5E0" BorderThickness="1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#E9F5ED" CornerRadius="7" Padding="10,6" VerticalAlignment="Center"><TextBlock Text="STATUS GERAL" Foreground="#0B6B3A" FontSize="11" FontWeight="Bold"/></Border>
    <TextBlock Grid.Column="1" x:Name="SummaryText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#35443C" Margin="12,0,0,0" VerticalAlignment="Center"/>
   </Grid>
  </Border>

  <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
   <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource ProTabItem}"/></TabControl.Resources>
   <TabItem Header="SAÚDE DO SISTEMA">
    <Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Border Background="#F7FAF8" BorderBrush="#DFE7E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,9"><TextBlock Text="Verificações críticas aparecem primeiro. Alertas não são corrigidos automaticamente para preservar rastreabilidade." TextWrapping="Wrap" Foreground="#66736C" FontSize="11"/></Border>
     <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="7">
      <DataGrid x:Name="ChecksGrid" Style="{StaticResource ProDataGrid}" ColumnHeaderStyle="{StaticResource ProDataGridHeader}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="STATUS" Binding="{Binding Level}" Width="92"/>
        <DataGridTextColumn Header="ÁREA" Binding="{Binding Area}" Width="120"/>
        <DataGridTextColumn Header="VERIFICAÇÃO" Binding="{Binding Code}" Width="160"/>
        <DataGridTextColumn Header="RESULTADO" Binding="{Binding Message}" Width="2*"/>
        <DataGridTextColumn Header="QTD." Binding="{Binding Count}" Width="65"/>
        <DataGridTextColumn Header="DETALHES / ORIENTAÇÃO" Binding="{Binding Details}" Width="3*"/>
       </DataGrid.Columns>
      </DataGrid>
     </Border>
    </Grid>
   </TabItem>

   <TabItem Header="DUPLICIDADES">
    <Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Border Background="#FFF8EE" BorderBrush="#F0E0C7" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,9"><TextBlock Text="Possíveis duplicidades são apenas sinalizadas. O sistema não exclui nem mescla registros automaticamente." TextWrapping="Wrap" Foreground="#755A35" FontSize="11"/></Border>
     <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="7">
      <DataGrid x:Name="DuplicatesGrid" Style="{StaticResource ProDataGrid}" ColumnHeaderStyle="{StaticResource ProDataGridHeader}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="ENTIDADE" Binding="{Binding Entity}" Width="120"/>
        <DataGridTextColumn Header="CAMPO" Binding="{Binding Field}" Width="150"/>
        <DataGridTextColumn Header="VALOR" Binding="{Binding Value}" Width="2*"/>
        <DataGridTextColumn Header="QTD." Binding="{Binding Count}" Width="65"/>
        <DataGridTextColumn Header="ORIENTAÇÃO" Binding="{Binding Details}" Width="3*"/>
       </DataGrid.Columns>
      </DataGrid>
     </Border>
    </Grid>
   </TabItem>

   <TabItem Header="DIAGNÓSTICO DO CREDIÁRIO">
    <Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Border Background="#F7FAF8" BorderBrush="#DFE7E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,9"><TextBlock Text="Mostra por que uma conta exige atenção antes de receber, arquivar ou excluir administrativamente." TextWrapping="Wrap" Foreground="#66736C" FontSize="11"/></Border>
     <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="7">
      <DataGrid x:Name="CreditsGrid" Style="{StaticResource ProDataGrid}" ColumnHeaderStyle="{StaticResource ProDataGridHeader}" AutoGenerateColumns="False" IsReadOnly="True" FrozenColumnCount="3" HorizontalScrollBarVisibility="Auto">
       <DataGrid.Columns>
        <DataGridTextColumn Header="VENDA" Binding="{Binding SaleNumber,StringFormat=000000}" Width="80"/>
        <DataGridTextColumn Header="CLIENTE" Binding="{Binding Customer}" Width="210"/>
        <DataGridTextColumn Header="DIAGNÓSTICO" Binding="{Binding Diagnosis}" Width="145"/>
        <DataGridTextColumn Header="CONTA" Binding="{Binding AccountStatus}" Width="100"/>
        <DataGridTextColumn Header="VENDA" Binding="{Binding SaleStatus}" Width="100"/>
        <DataGridTextColumn Header="ORIGINAL" Binding="{Binding Original,StringFormat=C}" Width="100"/>
        <DataGridTextColumn Header="SALDO" Binding="{Binding Balance,StringFormat=C}" Width="100"/>
        <DataGridTextColumn Header="RECIBOS" Binding="{Binding Receipts,StringFormat=C}" Width="100"/>
        <DataGridTextColumn Header="CAIXA" Binding="{Binding Cash,StringFormat=C}" Width="100"/>
        <DataGridTextColumn Header="PEND." Binding="{Binding PendingIntents}" Width="65"/>
        <DataGridTextColumn Header="SEM VÍNCULO" Binding="{Binding UnlinkedReceipts}" Width="85"/>
        <DataGridCheckBoxColumn Header="ARQUIVADO" Binding="{Binding Archived}" Width="78"/>
        <DataGridTextColumn Header="MOTIVO / ORIENTAÇÃO" Binding="{Binding Reason}" Width="420"/>
       </DataGrid.Columns>
      </DataGrid>
     </Border>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</Window>
