<Window x:Class="OncaPDV.Desktop.ReceiveCreditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Receber crediário" Width="480" Height="500" WindowStartupLocation="CenterOwner" Background="#F3F6F4" FontFamily="Segoe UI">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources><StackPanel Margin="24"><TextBlock x:Name="Customer" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="Balance" FontSize="18" Margin="0,4,0,20"/><TextBlock Text="VALOR RECEBIDO"/><TextBox x:Name="AmountBox" FontSize="22" TextChanged="Amount_Changed"/><TextBlock Text="FORMA DE PAGAMENTO" Margin="0,15,0,0"/><ComboBox x:Name="MethodBox" FontSize="18"><ComboBoxItem Content="Dinheiro" IsSelected="True"/><ComboBoxItem Content="Pix"/><ComboBoxItem Content="Débito"/><ComboBoxItem Content="Crédito"/></ComboBox><Border Background="#EEF8F1" Padding="10" Margin="0,12,0,0"><TextBlock x:Name="RemainingText" Text="Saldo após recebimento: R$ 0,00" FontWeight="SemiBold" Foreground="#0A6B38"/></Border><TextBlock Text="OBSERVAÇÃO" Margin="0,15,0,0"/><TextBox x:Name="NotesBox"/><Button Content="CONFIRMAR RECEBIMENTO" Margin="0,20,0,0" Click="Confirm_Click" IsDefault="True"/></StackPanel></Window>
