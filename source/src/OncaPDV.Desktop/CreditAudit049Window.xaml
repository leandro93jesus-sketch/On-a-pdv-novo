<Window x:Class="OncaPDV.Desktop.CreditAudit049Window" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Auditoria de contas excluídas — ONÇA PDV PRO" Width="1120" Height="660" MinWidth="800" MinHeight="480" WindowStartupLocation="CenterOwner" Background="#F7F9F8" FontFamily="Segoe UI">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14"><TextBlock Text="AUDITORIA — CONTAS EXCLUÍDAS" FontSize="23" FontWeight="Bold" Foreground="#793022"/><TextBlock Text="Histórico separado do crediário operacional. Estas contas não estão em cobrança. Vendas e recibos são preservados." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#606B65"/></StackPanel>
    <DataGrid Grid.Row="1" x:Name="AuditGrid" IsReadOnly="True" AutoGenerateColumns="False" RowHeight="36" FontSize="13"><DataGrid.Columns>
      <DataGridTextColumn Header="CLIENTE" Binding="{Binding Customer}" Width="*"/>
      <DataGridTextColumn Header="VENDA" Binding="{Binding SaleNumber}" Width="75"/>
      <DataGridTextColumn Header="VALOR ORIGINAL" Binding="{Binding Original,StringFormat=C}" Width="120"/>
      <DataGridTextColumn Header="RECEBIDO" Binding="{Binding Paid,StringFormat=C}" Width="110"/>
      <DataGridTextColumn Header="SALDO BAIXADO" Binding="{Binding Forgiven,StringFormat=C}" Width="125"/>
      <DataGridTextColumn Header="DATA EXCLUSÃO" Binding="{Binding RemovedAtDisplay}" Width="135"/>
      <DataGridTextColumn Header="MOTIVO / RESPONSÁVEL" Binding="{Binding Reason}" Width="2*"/>
      <DataGridTextColumn Header="ALERTA FINANCEIRO / LEGADO" Binding="{Binding FinancialAlert}" Width="2*"/>
    </DataGrid.Columns></DataGrid>
    <DockPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="Summary" VerticalAlignment="Center" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="FECHAR" HorizontalAlignment="Right" Padding="20,9" Click="Close_Click"/></DockPanel>
  </Grid>
</Window>
