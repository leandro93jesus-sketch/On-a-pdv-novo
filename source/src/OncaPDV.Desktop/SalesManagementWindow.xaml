<Window x:Class="OncaPDV.Desktop.SalesManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Vendas e pós-venda — ONÇA PDV PRO" Width="1420" Height="840" MinWidth="1180" MinHeight="700" WindowStartupLocation="CenterOwner" Background="#F3F6F4" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Vendas e pós-venda" FontSize="27" FontWeight="Bold" Foreground="#17231D"/><TextBlock Text="Consulte vendas, visualize comprovantes e execute correções administrativas com rastreabilidade." Foreground="#6F7C75" Margin="0,3,0,14"/></StackPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" ToolTip="Número, cliente, produto, código, valor ou pagamento"/><ComboBox Grid.Column="1" x:Name="StatusBox"><ComboBoxItem Content="Todos" IsSelected="True"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Cancelled"/><ComboBoxItem Content="Excluídas"/><ComboBoxItem Content="Todas inclusive excluídas"/></ComboBox><Button Grid.Column="2" Content="PESQUISAR" Style="{StaticResource ProPrimaryButton}" Click="Search_Click"/></Grid></Border>
  <Grid Grid.Row="2" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="7"><DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Grid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="VENDA" Binding="{Binding Number,StringFormat=000000}" Width="80"/><DataGridTextColumn Header="DATA / HORA" Binding="{Binding CreatedAt,StringFormat=dd/MM/yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="CLIENTE" Binding="{Binding Customer}" Width="*"/><DataGridTextColumn Header="TOTAL" Binding="{Binding Total,StringFormat=C}" Width="110"/><DataGridTextColumn Header="PAGAMENTO" Binding="{Binding Payments}" Width="160"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="FISCAL" Binding="{Binding FiscalStatus}" Width="100"/></DataGrid.Columns></DataGrid></Border>
   <Border Grid.Column="2" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="ReceiptTitle" Text="COMPROVANTE DA VENDA" FontSize="17" FontWeight="Bold" Foreground="#17231D"/><TextBlock Text="Prévia do comprovante já salvo" FontSize="11" Foreground="#748078" Margin="0,2,0,8"/></StackPanel><TextBox Grid.Row="1" x:Name="ReceiptText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#FCFDFC" BorderBrush="#E2E8E5"/><WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="VER CUPOM GRANDE" Click="View_Click"/><Button Content="REIMPRIMIR" Click="Reprint_Click"/><Button Content="PDF" Click="Pdf_Click"/></WrapPanel></Grid></Border>
  </Grid>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <WrapPanel><Button Content="EDITAR VENDA FINALIZADA" Style="{StaticResource ProPrimaryButton}" Click="Edit_Click"/><Button Content="ALTERAR PAGAMENTO" Click="Payment_Click"/><Button Content="RASCUNHO FISCAL" Click="Fiscal_Click"/><Button Content="WHATSAPP ENTREGA" Click="Delivery_Click"/></WrapPanel>
   <Expander Grid.Column="1" Header="AÇÕES ADMINISTRATIVAS" HorizontalAlignment="Right"><Border Background="#FFF7F6" BorderBrush="#F0D9D6" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,5,0,0"><StackPanel Orientation="Horizontal"><Button Content="CANCELAR VENDA" Style="{StaticResource ProDangerButton}" Click="Cancel_Click"/><Button Content="EXCLUIR VENDA" Style="{StaticResource ProDangerButton}" Click="Delete044_Click"/></StackPanel></Border></Expander>
  </Grid>
 </Grid>
</Window>
