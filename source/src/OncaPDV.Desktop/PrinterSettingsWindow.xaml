<Window x:Class="OncaPDV.Desktop.PrinterSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configurações → Impressora por terminal" Width="680" Height="700" WindowStartupLocation="CenterOwner" Background="#F3F6F4"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="TERMINAL" FontWeight="Bold"/><TextBox x:Name="TerminalId" Text="CAIXA-01" FontSize="17" Padding="8"/><TextBlock Text="IMPRESSORA" FontWeight="Bold" Margin="0,14,0,0"/><ComboBox x:Name="Printers" FontSize="17" Padding="8" DisplayMemberPath="QueueName"/><TextBlock Text="PAPEL" FontWeight="Bold" Margin="0,14,0,0"/><ComboBox x:Name="Paper" FontSize="17" Padding="8"><ComboBoxItem Content="58 mm"/><ComboBoxItem Content="80 mm" IsSelected="True"/></ComboBox><TextBlock Text="BACKEND" FontWeight="Bold" Margin="0,14,0,0"/><ComboBox x:Name="Backend" FontSize="17" Padding="8"><ComboBoxItem Content="EscPosRaw" IsSelected="True"/><ComboBoxItem Content="WindowsDriver"/></ComboBox><TextBlock Text="ENCODING" FontWeight="Bold" Margin="0,14,0,0"/><ComboBox x:Name="Encoding" FontSize="17" Padding="8"><ComboBoxItem Content="CP850" IsSelected="True"/><ComboBoxItem Content="CP858"/><ComboBoxItem Content="CP860"/></ComboBox><CheckBox x:Name="Cut" Content="Corte automático" IsEnabled="False" Margin="0,18,0,0" FontSize="16"/><CheckBox x:Name="Drawer" Content="Abrir gaveta" IsEnabled="False" Margin="0,8" FontSize="16"/><TextBlock Text="MODO FÍSICO: ATIVO — somente após sua confirmação" Foreground="#087233" FontWeight="Bold" Margin="0,15"/><WrapPanel><Button Content="SALVAR PERFIL" Padding="16,10" Click="Save_Click"/><Button Content="CARREGAR" Padding="16,10" Click="Load_Click"/><Button Content="VISUALIZAR" Padding="16,10" Click="Preview_Click"/><Button Content="TESTE MOCK" Padding="16,10" Click="Mock_Click"/><Button Content="TESTE FÍSICO" Padding="16,10" Margin="8,0,0,0" Click="Physical_Click"/></WrapPanel><TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></ScrollViewer></Window>
