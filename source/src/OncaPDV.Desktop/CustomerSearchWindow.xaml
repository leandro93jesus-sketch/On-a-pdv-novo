<Window x:Class="OncaPDV.Desktop.CustomerSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Clientes — ONÇA PDV PRO" Width="1080" Height="700" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#F3F6F4" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Clientes" FontSize="27" FontWeight="Bold" Foreground="#17231D"/><TextBlock Text="Pesquise por nome, telefone, CPF ou CNPJ e acesse o histórico completo do cliente." Foreground="#6F7C75" Margin="0,3,0,14"/></StackPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Query" FontSize="17" KeyDown="Query_KeyDown" ToolTip="Nome, telefone, CPF ou CNPJ"/><Button Grid.Column="1" Content="PESQUISAR" Style="{StaticResource ProPrimaryButton}" Click="Search_Click"/><Button Grid.Column="2" Content="NOVO CLIENTE" Click="New_Click"/></Grid></Border>
  <Border Grid.Row="2" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="7" Margin="0,10"><DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Select_Click"><DataGrid.Columns><DataGridTextColumn Header="NOME" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="TELEFONE" Binding="{Binding Phone}" Width="150"/><DataGridTextColumn Header="CPF" Binding="{Binding Cpf}" Width="135"/><DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj}" Width="170"/><DataGridCheckBoxColumn Header="ATIVO" Binding="{Binding Active}" Width="75"/></DataGrid.Columns></DataGrid></Border>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Duplo clique seleciona o cliente na operação atual." Foreground="#75827B" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><Button Content="EDITAR" Click="Edit_Click"/><Button Content="ATIVAR / INATIVAR" Click="Toggle_Click"/><Button Content="HISTÓRICO" Click="History_Click"/><Button Content="CREDIÁRIO" Click="Credit_Click"/><Button x:Name="SelectButton" Style="{StaticResource ProPrimaryButton}" Content="SELECIONAR" Click="Select_Click"/></WrapPanel></Grid>
 </Grid>
</Window>
