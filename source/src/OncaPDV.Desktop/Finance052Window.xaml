<Window x:Class="OncaPDV.Desktop.Finance052Window"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Financeiro — ONÇA PDV PRO 0.2.3" Width="1340" Height="840" MinWidth="1120" MinHeight="720"
 WindowStartupLocation="CenterOwner" Background="#F3F6F4" FontFamily="Segoe UI">
 <Window.Resources>
  <ResourceDictionary>
<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/>
                <ResourceDictionary Source="ProfessionalTheme0200.xaml"/>
            </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Financeiro" FontSize="27" FontWeight="Bold" Foreground="#17231D"/>
    <TextBlock Text="Contas a pagar e despesas separadas da operação diária do caixa." Foreground="#6F7C75" FontSize="13" Margin="0,3,0,0"/>
   </StackPanel>
   <Button Grid.Column="1" Style="{StaticResource ProSecondaryButton}" Content="ATUALIZAR" MinWidth="120" Click="Refresh_Click"/>
  </Grid>

  <Border Grid.Row="1" Margin="0,14,0,12" Padding="13" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#E9F5ED" CornerRadius="7" Padding="10,6" VerticalAlignment="Center"><TextBlock Text="RESUMO DO MÊS" Foreground="#0B6B3A" FontSize="11" FontWeight="Bold"/></Border>
    <TextBlock Grid.Column="1" x:Name="SummaryText" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#35443C" Margin="12,0,0,0" VerticalAlignment="Center"/>
   </Grid>
  </Border>

  <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
   <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource ProTabItem}"/></TabControl.Resources>

   <TabItem Header="CONTAS A PAGAR">
    <Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="13">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0" Margin="4"><TextBlock Text="FORNECEDOR" Style="{StaticResource ProLabel}"/><TextBox x:Name="PaySupplier" Style="{StaticResource ProTextBox}" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="DESCRIÇÃO" Style="{StaticResource ProLabel}"/><TextBox x:Name="PayDescription" Style="{StaticResource ProTextBox}" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="CATEGORIA" Style="{StaticResource ProLabel}"/><ComboBox x:Name="PayCategory" Style="{StaticResource ProComboBox}" IsEditable="True" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="DOCUMENTO / NF" Style="{StaticResource ProLabel}"/><TextBox x:Name="PayDocument" Style="{StaticResource ProTextBox}" Margin="0,4,0,0"/></StackPanel>

       <StackPanel Grid.Row="1" Grid.Column="0" Margin="4"><TextBlock Text="VALOR TOTAL" Style="{StaticResource ProLabel}"/><TextBox x:Name="PayTotal" Style="{StaticResource ProTextBox}" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="1" Margin="4"><TextBlock Text="PRIMEIRO VENCIMENTO" Style="{StaticResource ProLabel}"/><DatePicker x:Name="PayFirstDue" MinHeight="36" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="2" Margin="4"><TextBlock Text="PARCELAS" Style="{StaticResource ProLabel}"/><TextBox x:Name="PayInstallments" Style="{StaticResource ProTextBox}" Text="1" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="3" Margin="4"><TextBlock Text="OBSERVAÇÕES" Style="{StaticResource ProLabel}"/><TextBox x:Name="PayNotes" Style="{StaticResource ProTextBox}" Margin="0,4,0,0"/></StackPanel>

       <Grid Grid.Row="2" Grid.ColumnSpan="4" Margin="4,9,4,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Mostrar" Style="{StaticResource ProLabel}" VerticalAlignment="Center"/><ComboBox x:Name="PayFilter" Style="{StaticResource ProComboBox}" Width="160" Margin="8,0,0,0" SelectionChanged="PayFilter_SelectionChanged"/></StackPanel>
        <TextBlock Grid.Column="1" Text="Cadastre uma vez e o sistema cria as parcelas." Foreground="#7A8780" FontSize="11" VerticalAlignment="Center" Margin="12,0"/>
        <Button Grid.Column="2" Style="{StaticResource ProPrimaryButton}" Content="CADASTRAR CONTA / PARCELAS" MinWidth="210" Click="CreatePayable_Click"/>
       </Grid>
      </Grid>
     </Border>

     <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="7" Margin="0,10,0,10">
      <DataGrid x:Name="PayablesGrid" Style="{StaticResource ProDataGrid}" ColumnHeaderStyle="{StaticResource ProDataGridHeader}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="PayablesGrid_SelectionChanged" HorizontalScrollBarVisibility="Auto">
       <DataGrid.Columns>
        <DataGridTextColumn Header="FORNECEDOR" Binding="{Binding Supplier}" Width="170"/>
        <DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Description}" Width="*"/>
        <DataGridTextColumn Header="CATEGORIA" Binding="{Binding Category}" Width="115"/>
        <DataGridTextColumn Header="PARCELA" Binding="{Binding InstallmentNumber}" Width="58"/>
        <DataGridTextColumn Header="DE" Binding="{Binding InstallmentCount}" Width="42"/>
        <DataGridTextColumn Header="VENCIMENTO" Binding="{Binding DueAt,StringFormat=dd/MM/yyyy}" Width="98"/>
        <DataGridTextColumn Header="VALOR" Binding="{Binding Amount,StringFormat=C}" Width="98"/>
        <DataGridTextColumn Header="PAGO" Binding="{Binding Paid,StringFormat=C}" Width="98"/>
        <DataGridTextColumn Header="SALDO" Binding="{Binding Remaining,StringFormat=C}" Width="98"/>
        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="108"/>
        <DataGridTextColumn Header="DOCUMENTO" Binding="{Binding DocumentNumber}" Width="120"/>
       </DataGrid.Columns>
      </DataGrid>
     </Border>

     <Border Grid.Row="2" Padding="11" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="145"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="PAGAR SELECIONADA" Style="{StaticResource ProLabel}"/><TextBlock Text="Pagamento parcial ou total" FontSize="10" Foreground="#87928C"/></StackPanel>
       <TextBox x:Name="PayPaymentAmount" Grid.Column="1" Style="{StaticResource ProTextBox}" Margin="10,0,4,0" ToolTip="Valor a pagar"/>
       <ComboBox x:Name="PayPaymentMethod" Grid.Column="2" Style="{StaticResource ProComboBox}" Margin="4,0"/>
       <TextBox x:Name="PayPaymentNotes" Grid.Column="3" Style="{StaticResource ProTextBox}" Margin="4,0" ToolTip="Observação do pagamento"/>
       <Button Grid.Column="4" Style="{StaticResource ProPrimaryButton}" Content="REGISTRAR PAGAMENTO" Margin="6,0" Click="PaySelected_Click"/>
       <Button Grid.Column="5" Style="{StaticResource ProDangerButton}" Content="CANCELAR CONTA" Margin="4,0" Click="CancelPayable_Click"/>
      </Grid>
     </Border>
    </Grid>
   </TabItem>

   <TabItem Header="DESPESAS">
    <Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Border Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="13">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
       <StackPanel Grid.Column="0" Margin="4"><TextBlock Text="CATEGORIA" Style="{StaticResource ProLabel}"/><ComboBox x:Name="ExpenseCategory" Style="{StaticResource ProComboBox}" IsEditable="True" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="DESCRIÇÃO" Style="{StaticResource ProLabel}"/><TextBox x:Name="ExpenseDescription" Style="{StaticResource ProTextBox}" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="VALOR" Style="{StaticResource ProLabel}"/><TextBox x:Name="ExpenseAmount" Style="{StaticResource ProTextBox}" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="FORMA DE PAGAMENTO" Style="{StaticResource ProLabel}"/><ComboBox x:Name="ExpenseMethod" Style="{StaticResource ProComboBox}" Margin="0,4,0,0"/></StackPanel>

       <StackPanel Grid.Row="1" Grid.Column="0" Margin="4"><TextBlock Text="FORNECEDOR (OPCIONAL)" Style="{StaticResource ProLabel}"/><TextBox x:Name="ExpenseSupplier" Style="{StaticResource ProTextBox}" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="1" Margin="4"><TextBlock Text="DOCUMENTO / NF" Style="{StaticResource ProLabel}"/><TextBox x:Name="ExpenseDocument" Style="{StaticResource ProTextBox}" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="2" Margin="4"><TextBlock Text="DATA" Style="{StaticResource ProLabel}"/><DatePicker x:Name="ExpenseDate" MinHeight="36" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="3" Margin="4"><TextBlock Text="OBSERVAÇÕES" Style="{StaticResource ProLabel}"/><TextBox x:Name="ExpenseNotes" Style="{StaticResource ProTextBox}" Margin="0,4,0,0"/></StackPanel>

       <Grid Grid.Row="2" Grid.ColumnSpan="4" Margin="4,9,4,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Dinheiro exige caixa aberto. PIX, cartão, boleto e transferência ficam no financeiro sem reduzir o dinheiro físico." TextWrapping="Wrap" Foreground="#6A5443" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
        <Button Grid.Column="1" Style="{StaticResource ProPrimaryButton}" Content="REGISTRAR DESPESA" MinWidth="180" Click="AddExpense_Click"/>
       </Grid>
      </Grid>
     </Border>

     <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="7" Margin="0,10,0,0">
      <DataGrid x:Name="ExpensesGrid" Style="{StaticResource ProDataGrid}" ColumnHeaderStyle="{StaticResource ProDataGridHeader}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
       <DataGrid.Columns>
        <DataGridTextColumn Header="DATA" Binding="{Binding OccurredAt,StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
        <DataGridTextColumn Header="CATEGORIA" Binding="{Binding Category}" Width="115"/>
        <DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Description}" Width="*"/>
        <DataGridTextColumn Header="FORNECEDOR" Binding="{Binding Supplier}" Width="150"/>
        <DataGridTextColumn Header="DOCUMENTO" Binding="{Binding DocumentNumber}" Width="110"/>
        <DataGridTextColumn Header="VALOR" Binding="{Binding Amount,StringFormat=C}" Width="100"/>
        <DataGridTextColumn Header="PAGAMENTO" Binding="{Binding Method}" Width="115"/>
        <DataGridTextColumn Header="ORIGEM" Binding="{Binding Source}" Width="88"/>
        <DataGridTextColumn Header="OBSERVAÇÃO" Binding="{Binding Notes}" Width="190"/>
       </DataGrid.Columns>
      </DataGrid>
     </Border>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</Window>
