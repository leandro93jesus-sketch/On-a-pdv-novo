<Window x:Class="OncaPDV.Desktop.DiversosWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Diversos — ONÇA PDV PRO 0.2.3" Width="640" Height="620" MinWidth="580" MinHeight="560"
 WindowStartupLocation="CenterOwner" Background="#F3F6F4" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/>
  <ResourceDictionary Source="ProfessionalTheme0200.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#0B6B3A" CornerRadius="0,0,18,18">
   <Grid Margin="26,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="DIVERSOS" Foreground="White" FontSize="27" FontWeight="Bold"/><TextBlock Text="Item avulso sem cadastro • não movimenta estoque" Foreground="#DDEFE5" FontSize="13" Margin="0,4,0,0"/></StackPanel>
    <Border Grid.Column="1" Background="#187A48" CornerRadius="8" Padding="10,6" VerticalAlignment="Center"><TextBlock Text="ATALHO F4" Foreground="White" FontWeight="Bold" FontSize="11"/></Border>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="24,18,24,24">
    <Border Background="White" CornerRadius="12" BorderBrush="#DCE5DF" BorderThickness="1" Padding="20">
     <StackPanel>
      <TextBlock Text="DADOS DO ITEM" Style="{StaticResource ProSectionTitle}" Margin="0,0,0,14"/>
      <TextBlock Text="DESCRIÇÃO" Style="{StaticResource ProLabel}"/><TextBox x:Name="DescriptionBox" Style="{StaticResource ProTextBox}" Margin="0,6,0,14" FontSize="17"/>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="VALOR UNITÁRIO" Style="{StaticResource ProLabel}"/><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#EDF6F0" CornerRadius="8,0,0,8"><TextBlock Text="R$" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#0B6B3A"/></Border><TextBox Grid.Column="1" x:Name="PriceBox" Style="{StaticResource ProTextBox}" FontSize="22" FontWeight="SemiBold" KeyDown="PriceBox_KeyDown"/></Grid></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="QUANTIDADE" Style="{StaticResource ProLabel}"/><TextBox x:Name="QuantityBox" Style="{StaticResource ProTextBox}" Text="1" Margin="0,6,0,0" FontSize="18"/></StackPanel>
      </Grid>
      <Border Background="#F7FAF8" BorderBrush="#E1E8E4" BorderThickness="1" CornerRadius="8" Padding="12">
       <StackPanel><TextBlock Text="ÚLTIMOS DIVERSOS USADOS" Style="{StaticResource ProLabel}"/><TextBlock Text="Dê dois cliques para reutilizar a descrição." Foreground="#7D8983" FontSize="10" Margin="0,3,0,7"/><ListBox x:Name="RecentList" Height="92" MouseDoubleClick="Recent_DoubleClick"/></StackPanel>
      </Border>
     </StackPanel>
    </Border>
    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource ProSecondaryButton}" Content="CANCELAR" Padding="18,12" Margin="0,0,6,0" IsCancel="True"/>
     <Button Grid.Column="1" Style="{StaticResource ProPrimaryButton}" Content="ADICIONAR AO CARRINHO" Padding="18,12" Margin="6,0,0,0" FontWeight="Bold" Click="Add_Click" IsDefault="True"/>
    </Grid>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>