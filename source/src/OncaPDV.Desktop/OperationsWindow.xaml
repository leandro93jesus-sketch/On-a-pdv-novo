<Window x:Class="OncaPDV.Desktop.OperationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Caixa e operações — ONÇA PDV PRO" Width="1220" Height="790" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterOwner" Background="#F3F6F4" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Caixa e operações" FontSize="27" FontWeight="Bold" Foreground="#17231D"/><TextBlock Text="Relatórios, fechamento, histórico de caixa e segurança de backup em uma área administrativa." Foreground="#6F7C75" Margin="0,3,0,14"/></StackPanel>
  <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="VENDAS"><Grid Margin="0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><WrapPanel><Button Content="HOJE" Click="Today_Click"/><Button Content="ONTEM" Click="Yesterday_Click"/><Button Content="ESTE MÊS" Click="Month_Click"/><TextBlock Text="De" VerticalAlignment="Center" Margin="12,0,2,0"/><DatePicker x:Name="From"/><TextBlock Text="Até" VerticalAlignment="Center" Margin="8,0,2,0"/><DatePicker x:Name="To"/><Button Content="APLICAR PERÍODO" Click="Period_Click"/></WrapPanel><Border Grid.Row="1" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,10"><TextBlock x:Name="SalesSummaryText" FontSize="16" TextWrapping="Wrap" Foreground="#27342E"/></Border><Button Grid.Row="2" Content="GERAR PDF DO RELATÓRIO" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ReportPdf_Click"/></Grid></TabItem>
   <TabItem Header="ESTOQUE"><Grid Margin="0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><CheckBox x:Name="BelowMinimum" Content="Mostrar somente produtos abaixo do mínimo" Checked="StockFilter" Unchecked="StockFilter"/><Border Grid.Row="1" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="7"><DataGrid x:Name="StockGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="PRODUTO" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="CÓDIGO" Binding="{Binding Code}" Width="120"/><DataGridTextColumn Header="ESTOQUE" Binding="{Binding Stock,StringFormat=N3}" Width="100"/><DataGridTextColumn Header="MÍNIMO" Binding="{Binding Minimum,StringFormat=N3}" Width="100"/><DataGridTextColumn Header="CUSTO" Binding="{Binding Cost,StringFormat=C}" Width="110"/><DataGridTextColumn Header="VENDA" Binding="{Binding Price,StringFormat=C}" Width="110"/><DataGridTextColumn Header="VALOR EST." Binding="{Binding Estimated,StringFormat=C}" Width="120"/></DataGrid.Columns></DataGrid></Border></Grid></TabItem>
   <TabItem Header="FECHAMENTO"><Grid Margin="0,14" MaxWidth="760" HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Border Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="Fechamento de caixa" FontSize="20" FontWeight="Bold"/><TextBlock Text="Informe o valor físico contado. O sistema compara com o esperado e registra a diferença." Foreground="#6F7C75" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="VALOR INFORMADO" Style="{StaticResource ProLabel}"/><TextBox x:Name="Informed" FontSize="24"/><Button Content="FECHAR CAIXA" Style="{StaticResource ProPrimaryButton}" Margin="3,10,3,3" Click="Close_Click"/></StackPanel></Border><TextBlock Grid.Row="1" x:Name="ClosingText" FontSize="15" TextWrapping="Wrap" Margin="4,14"/></Grid></TabItem>
   <TabItem Header="HOJE"><Grid Margin="0,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="Resumo rápido do dia" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="TodaySummary" FontSize="16" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border><Button Grid.Row="1" Content="ATUALIZAR" HorizontalAlignment="Left" Margin="0,10,0,0" Click="TodaySummary_Click"/></Grid></TabItem>
   <TabItem Header="HISTÓRICO DO CAIXA"><Grid Margin="0,10"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="7"><DataGrid x:Name="CashHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="DATA / HORA" Binding="{Binding CreatedAt,StringFormat=dd/MM/yyyy HH:mm}" Width="150"/><DataGridTextColumn Header="TIPO" Binding="{Binding Type}" Width="140"/><DataGridTextColumn Header="VALOR" Binding="{Binding Amount,StringFormat=C}" Width="110"/><DataGridTextColumn Header="MOTIVO" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="ORIGEM" Binding="{Binding OriginId}" Width="240"/></DataGrid.Columns></DataGrid></Border><Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ReopenReason" ToolTip="Motivo obrigatório para reabrir caixa"/><Button Grid.Column="1" Content="ATUALIZAR" Click="CashHistory_Click"/><Button Grid.Column="2" Content="REABRIR ÚLTIMO CAIXA" Style="{StaticResource ProDangerButton}" Click="Reopen_Click"/></Grid></Grid></TabItem>
   <TabItem Header="BACKUP"><Grid Margin="0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button Content="BACKUP MANUAL VALIDADO" Click="Backup_Click"/><Button Content="IMPORTAR PDV ANTIGO" Click="LegacyImport_Click"/></WrapPanel><ListBox Grid.Row="1" x:Name="Backups" Margin="3,10"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="BackupStatus" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#5E6C64"/><Button Grid.Column="1" Content="VALIDAR E RESTAURAR SELECIONADO" Click="Restore_Click"/></Grid></Grid></TabItem>
  </TabControl>
 </Grid>
</Window>
