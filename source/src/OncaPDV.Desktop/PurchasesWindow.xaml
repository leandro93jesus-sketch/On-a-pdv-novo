<Window x:Class="OncaPDV.Desktop.PurchasesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Compras e fornecedores — ONÇA PDV PRO" Width="1220" Height="780" MinWidth="1020" MinHeight="680" WindowStartupLocation="CenterOwner" Background="#F3F6F4" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Compras e fornecedores" FontSize="27" FontWeight="Bold" Foreground="#17231D"/><TextBlock Text="Cadastre fornecedores e registre entradas de compra com atualização de estoque." Foreground="#6F7C75" Margin="0,3,0,14"/></StackPanel>
  <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="FORNECEDORES"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="3"><TextBlock Text="NOME" Style="{StaticResource ProLabel}"/><TextBox x:Name="SupplierName"/></StackPanel><StackPanel Grid.Column="1" Margin="3"><TextBlock Text="CPF / CNPJ" Style="{StaticResource ProLabel}"/><TextBox x:Name="SupplierTax"/></StackPanel><StackPanel Grid.Column="2" Margin="3"><TextBlock Text="TELEFONE" Style="{StaticResource ProLabel}"/><TextBox x:Name="SupplierPhone"/></StackPanel><Button Grid.Column="3" Content="SALVAR" Style="{StaticResource ProPrimaryButton}" VerticalAlignment="Bottom" Margin="6,3" Click="SaveSupplier_Click"/><StackPanel Grid.Column="4" Margin="3"><TextBlock Text="BUSCAR" Style="{StaticResource ProLabel}"/><TextBox x:Name="SupplierSearch"/></StackPanel><Button Grid.Column="5" Content="PESQUISAR" VerticalAlignment="Bottom" Margin="6,3" Click="SearchSupplier_Click"/>
    </Grid></Border>
    <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="7" Margin="0,10,0,0"><DataGrid x:Name="SupplierGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="FORNECEDOR" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="CPF / CNPJ" Binding="{Binding TaxId}" Width="180"/><DataGridTextColumn Header="TELEFONE" Binding="{Binding Phone}" Width="160"/><DataGridCheckBoxColumn Header="ATIVO" Binding="{Binding Active}" Width="80"/></DataGrid.Columns></DataGrid></Border>
   </Grid></TabItem>
   <TabItem Header="ENTRADA DE COMPRA"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FORNECEDOR" Style="{StaticResource ProLabel}"/><ComboBox x:Name="SupplierCombo" DisplayMemberPath="Name"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DOCUMENTO" Style="{StaticResource ProLabel}"/><TextBox x:Name="DocumentNumber"/></StackPanel></Grid></Border>
    <Border Grid.Row="1" Background="#F7FAF8" BorderBrush="#DFE7E2" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,10,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="IMPORTAR XML / CSV" Click="ImportPurchase_Click"/><TextBox Grid.Column="1" x:Name="ProductSearch" ToolTip="Código ou produto"/><TextBox Grid.Column="2" x:Name="Quantity" Text="1" ToolTip="Quantidade"/><TextBox Grid.Column="3" x:Name="UnitCost" ToolTip="Custo unitário"/><Button Grid.Column="4" Content="ADICIONAR ITEM" Style="{StaticResource ProPrimaryButton}" Click="AddItem_Click"/></Grid></Border>
    <Border Grid.Row="2" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="10" Padding="7"><DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="CÓDIGO" Binding="{Binding Code}" Width="120"/><DataGridTextColumn Header="PRODUTO" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="QTD." Binding="{Binding Quantity,StringFormat=N3}" Width="100"/><DataGridTextColumn Header="CUSTO UNIT." Binding="{Binding UnitCost,StringFormat=C}" Width="120"/><DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal,StringFormat=C}" Width="120"/></DataGrid.Columns></DataGrid></Border>
    <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PurchaseTotal" Text="TOTAL: R$ 0,00" FontSize="27" FontWeight="Bold" Foreground="#17231D" VerticalAlignment="Center"/><Button Grid.Column="1" Content="CONFIRMAR ENTRADA" Style="{StaticResource ProPrimaryButton}" MinWidth="190" Click="CompletePurchase_Click"/></Grid>
   </Grid></TabItem>
  </TabControl>
 </Grid>
</Window>
