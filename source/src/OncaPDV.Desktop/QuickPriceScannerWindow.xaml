<Window x:Class="OncaPDV.Desktop.QuickPriceScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consulta rápida de preço — ONÇA PDV PRO 0.2.3"
        Width="650" Height="430" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F3F6F4" FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/><ResourceDictionary Source="ProfessionalTheme0200.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CONSULTA DE PREÇO" FontSize="24" FontWeight="Bold" Foreground="#173D2A"/>
            <TextBlock Text="Leia o código de barras ou digite código/nome. Nada é lançado na venda até você escolher ADICIONAR." Foreground="#66746C" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" Style="{StaticResource ProTextBox}" FontSize="22" Padding="12,9" KeyDown="Query_KeyDown"/>
            <Button Grid.Column="1" Style="{StaticResource ProPrimaryButton}" Content="CONSULTAR" Margin="8,0,0,0" Click="Search_Click"/>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="NameText" Text="Aguardando leitura..." FontSize="23" FontWeight="Bold" Foreground="#24352C" TextWrapping="Wrap"/>
                <TextBlock x:Name="CodeText" Grid.Row="1" Margin="0,7,0,0" Foreground="#6C7972"/>
                <TextBlock x:Name="PriceText" Grid.Row="2" Margin="0,12,0,0" FontSize="38" FontWeight="Bold" Foreground="#0B6B3A"/>
                <TextBlock x:Name="StockText" Grid.Row="3" Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold" Foreground="#4C5A53"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
            <Button Style="{StaticResource ProSecondaryButton}" Content="FECHAR  [ESC]" HorizontalAlignment="Left" Width="120" Click="Close_Click"/>
            <Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource ProPrimaryButton}" Content="ADICIONAR AO CARRINHO" IsEnabled="False" Click="Add_Click"/>
        </Grid>
    </Grid>
</Window>
