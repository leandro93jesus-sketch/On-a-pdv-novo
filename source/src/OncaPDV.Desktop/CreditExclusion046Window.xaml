<Window x:Class="OncaPDV.Desktop.CreditExclusion046Window" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Excluir crediário — ONÇA PDV PRO" Width="530" Height="380" MinWidth="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F9F8" FontFamily="Segoe UI">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProfessionalCompatibility0210.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<Grid Margin="20">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="EXCLUIR CREDIÁRIO" FontSize="21" FontWeight="Bold" Foreground="#9C2820" Margin="0,0,0,12"/>
<TextBlock x:Name="AccountText" Grid.Row="1" TextWrapping="Wrap" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
<TextBlock Grid.Row="2" TextWrapping="Wrap" Text="A conta deixará de aparecer como dívida ativa. Somente o saldo ainda devido será baixado administrativamente. Pagamentos já recebidos e seus lançamentos no caixa serão preservados; a venda também continuará no histórico." Foreground="#654A34" Margin="0,0,0,14"/>
<StackPanel Grid.Row="3">
<TextBlock Text="Motivo obrigatório (mínimo 4 caracteres):" FontWeight="SemiBold" Margin="0,0,0,6"/>
<TextBox x:Name="ReasonBox" Padding="9" MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="500"/>
</StackPanel>
<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
<Button Content="CANCELAR" Padding="16,9" Margin="4" Click="Back_Click"/>
<Button Content="CONFIRMAR MOTIVO" Padding="16,9" Margin="4" Background="#9C2820" Foreground="White" FontWeight="Bold" Click="Confirm_Click"/>
</StackPanel>
</Grid></Window>