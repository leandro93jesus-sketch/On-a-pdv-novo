@@ -129,12 +129,40 @@ public sealed class PosWorkflow(
         }
     }
 
+    public async Task AddExistingProductAsync(Product product, CancellationToken ct = default)
+    {
+        if (!product.Active) throw new DomainException("Produto inativo.");
+        Cart.Add(product);
+        await recovery.SaveAsync(Cart, ct);
+    }
+
+    public async Task AddDiversosAsync(decimal price, string? description = null, CancellationToken ct = default)
+    {
+        if (price <= 0) throw new DomainException("Informe um preço maior que zero.");
+        var product = await products.FindAsync("DIVERSOS", ct) ?? throw new DomainException("Item DIVERSOS não encontrado.");
+        var name = string.IsNullOrWhiteSpace(description) ? "DIVERSOS" : $"DIVERSOS - {description.Trim()}";
+        Cart.AddWithPrice(product, price, 1, name);
+        await recovery.SaveAsync(Cart, ct);
+    }
+
     public async Task ChangeQuantityAsync(Guid productId, decimal quantity, CancellationToken ct = default)
     {
         Cart.ChangeQuantity(productId, quantity);
         await recovery.SaveAsync(Cart, ct);
     }
 
+    public async Task EditCartItemAsync(int lineIndex, string name, decimal quantity, decimal unitPrice, CancellationToken ct = default)
+    {
+        Cart.ChangeItem(lineIndex, name, quantity, unitPrice);
+        await recovery.SaveAsync(Cart, ct);
+    }
+
+    public async Task RemoveCartItemAsync(int lineIndex, CancellationToken ct = default)
+    {
+        Cart.RemoveItem(lineIndex);
+        await recovery.SaveAsync(Cart, ct);
+    }
+
     public async Task<Sale> CompleteAsync(IReadOnlyList<Payment> payments, Guid operatorId, CancellationToken ct = default)
     {
         var session = await cashSessions.GetOrOpenAsync(operatorId, 0, ct);
