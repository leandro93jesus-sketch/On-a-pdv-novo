<Window x:Class="OncaPDV.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ONÇA PDV PRO"
        Height="900" Width="1540" MinHeight="760" MinWidth="1240"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9F8"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#0B6B3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#26342E"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NavActiveButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#E7F3EB"/>
            <Setter Property="Foreground" Value="#0B6B3A"/>
        </Style>
        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="#EDF2EF"/>
            <Setter Property="Foreground" Value="#26342E"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="#FFF0F0"/>
            <Setter Property="Foreground" Value="#C62828"/>
        </Style>
        <Style x:Key="PaymentButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#D7E0DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7ECE9"/>
            <Setter Property="VerticalGridLinesBrush" Value="#F4F6F5"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFCFB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="RowHeight" Value="46"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F6F4"/>
            <Setter Property="Foreground" Value="#34423C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="BorderBrush" Value="#E4EAE7"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="370"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- Navegação lateral -->
        <Border Grid.Column="0" Grid.RowSpan="3" Background="White" BorderBrush="#E1E7E4" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition/><RowDefinition Height="90"/></Grid.RowDefinitions>
                <StackPanel Margin="20,18,14,8">
                    <TextBlock Text="ONÇA" FontSize="27" FontWeight="Bold" Foreground="#09652F"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PDV" FontSize="18" FontWeight="Bold" Foreground="#09652F"/>
                        <TextBlock Text=" PRO" FontSize="18" FontWeight="Bold" Foreground="#D28A14"/><TextBlock Text="  v0.1.21" FontSize="11" FontWeight="Bold" Foreground="#6B746F" VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                    </StackPanel>
                    <TextBlock Text="Onça Produtos de Limpeza" FontSize="12" Foreground="#738179" Margin="0,4,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,5">
                    <Button Style="{StaticResource NavActiveButton}" Content="🛒   Vendas"/>
                    <Button Style="{StaticResource NavButton}" Content="📦   Produtos" Click="Product_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="👥   Clientes" Click="CustomerManagement_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▣   Caixa" Click="Operations_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▤   Crediário" Click="Credit_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="🛒   Compras / Fornecedores" Click="Purchases_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▥   Relatórios" Click="Operations_Click"/><Button Style="{StaticResource NavButton}" Content="🧾   Gerenciar vendas" Click="ManageSales_Click"/><Button Style="{StaticResource NavButton}" Content="📄   Orçamentos / Notas" Click="Documents_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⏸   Colocar venda em espera" Click="HoldSale_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="↩   Trocas / Devoluções / Despesas" Click="FinalOps_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⚙   Configurações" Click="Printer_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="💾   Backup" Click="BackupCenter_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="🖥   Tela / Tamanho" Click="DisplaySettings_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="✓   Diagnóstico" Click="Diagnostic_Click"/>
                </StackPanel></ScrollViewer>
                <StackPanel Grid.Row="2" Margin="18,8,14,14" VerticalAlignment="Bottom">
                    <Border Background="#F2F8F4" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Produtos de limpeza" FontWeight="SemiBold" Foreground="#0B6B3A"/>
                            <TextBlock Text="Qualidade • Economia • Confiança" FontSize="11" Foreground="#6C7A73" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Topo -->
        <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Background="White" BorderBrush="#E1E7E4" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF7F1" CornerRadius="8" Padding="13,9">
                        <TextBlock Text="🏬  Loja Matriz" FontSize="15" FontWeight="SemiBold" Foreground="#244335"/>
                    </Border>
                    <TextBlock Text="  •  Caixa 001" VerticalAlignment="Center" Foreground="#77847D" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="ClockText" FontSize="15" FontWeight="SemiBold" Foreground="#36433D" VerticalAlignment="Center" Margin="14,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Border Background="#EAF8EF" CornerRadius="8" Padding="9,6" Margin="3,0"><TextBlock Text="● CAIXA ABERTO" Foreground="#087233" FontSize="12" FontWeight="Bold"/></Border>
                    <Border Background="#FFF7E8" CornerRadius="8" Padding="9,6" Margin="3,0"><TextBlock x:Name="LastBackupText" Text="Backup: manual" Foreground="#9A6200" FontSize="12" FontWeight="SemiBold"/></Border>
                </StackPanel>
                <Border Grid.Column="3" Background="#F6F8F7" CornerRadius="9" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="19" Margin="0,0,8,0"/>
                        <StackPanel><TextBlock Text="Caixa" FontSize="11" Foreground="#7B8881"/><TextBlock Text="Administrador" FontWeight="Bold" Foreground="#29352F"/></StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Centro: busca, carrinho, últimas vendas -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="18,16,10,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">


            <Border Background="White" BorderBrush="#DCE5E0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="▥" FontSize="27" Foreground="#0B6B3A" VerticalAlignment="Center" Margin="8,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" BorderThickness="0" KeyDown="SearchBox_KeyDown" ToolTip="Passe o código de barras ou digite código/nome" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Style="{StaticResource RoundedButton}" Content="ADICIONAR  [ENTER]" Click="Add_Click" Margin="8,0,4,0"/>
                    <Button Grid.Column="3" Style="{StaticResource SoftButton}" Content="PREÇO  [F3]" Click="PriceLookup_Click" Margin="4,0"/>
                    <Button Grid.Column="4" Style="{StaticResource SoftButton}" Content="PRODUTO  [F1]" Click="Product_Click" Margin="4,0,0,0"/>
                </Grid>
            </Border>

                <Border Background="#F2F8F4" BorderBrush="#D5E8DB" BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="5,0,12,0" VerticalAlignment="Center"><TextBlock Text="DIVERSOS" FontWeight="Bold" FontSize="14" Foreground="#0B6B3A"/><TextBlock Text="item sem cadastro" FontSize="10" Foreground="#708078"/></StackPanel>
                        <TextBox Grid.Column="1" x:Name="DiversosNameBox" ToolTip="Nome ou descrição do item" FontSize="15" Padding="9,7" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="2" x:Name="DiversosValueBox" ToolTip="Valor unitário em R$" FontSize="15" Padding="9,7" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="3" x:Name="DiversosQtyBox" Text="1" ToolTip="Quantidade" FontSize="15" Padding="9,7" Margin="0,0,6,0"/>
                        <Button Grid.Column="4" Style="{StaticResource RoundedButton}" Content="ADICIONAR DIVERSOS  [F4]" Click="InlineDiversosAdd_Click" Padding="12,8"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Background="White" BorderBrush="#E0E6E3" BorderThickness="1" CornerRadius="11" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/><RowDefinition Height="46"/></Grid.RowDefinitions>
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="🛒  Carrinho de Vendas" FontSize="21" FontWeight="Bold" Foreground="#1F2B25" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="StatusText" Text="CAIXA LIVRE" Foreground="#0B6B3A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="CartGrid" AutoGenerateColumns="False" CellEditEnding="CartGrid_CellEditEnding" Margin="10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Code}" IsReadOnly="True" Width="120"/>
                            <DataGridTextColumn Header="PRODUTO" Binding="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="QTD" Binding="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Width="82"/>
                            <DataGridTextColumn Header="UNITÁRIO (R$)" Binding="{Binding UnitPrice,UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" Width="112"/>
                            <DataGridTextColumn Header="TOTAL (R$)" Binding="{Binding Subtotal,StringFormat=N2}" IsReadOnly="True" Width="110"/>
                            <DataGridTemplateColumn Header="" Width="54">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Button Style="{StaticResource DangerButton}" Content="✕" Padding="8,3" Tag="{Binding Index}" Click="RemoveCartItem_Click" ToolTip="Remover item"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="13,2">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource DangerButton}" Content="🗑  Cancelar venda [ESC]" Click="Cancel_Click" HorizontalAlignment="Left"/>
                        <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="👤  Cliente" Click="Customer_Click"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Style="{StaticResource SoftButton}" Content="🧾  Visualizar cupom" Click="Preview_Click"/><Button Style="{StaticResource SoftButton}" Content="💾  Salvar orçamento" Click="SaveQuote_Click" Margin="6,0,0,0"/></StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="#E0E6E3" BorderThickness="1" CornerRadius="11">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="◷  5 Últimas Vendas" FontSize="17" FontWeight="Bold" Foreground="#26342E" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Ver, conferir e reimprimir rapidamente" Foreground="#7C8982" VerticalAlignment="Center"/>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="SalesGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="34" FontSize="13" Margin="10,0,10,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VENDA" Binding="{Binding Number,StringFormat=000000}" Width="90"/>
                            <DataGridTextColumn Header="DATA / HORA" Binding="{Binding CreatedAt,StringFormat=dd/MM HH:mm}" Width="120"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding Total,StringFormat=C}" Width="110"/>
                            <DataGridTemplateColumn Header="AÇÕES" Width="*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SoftButton}" Content="VER" Padding="9,3" Tag="{Binding Id}" Click="ViewSale_Click"/>
                                    <Button Style="{StaticResource SoftButton}" Content="REIMPRIMIR" Padding="9,3" Tag="{Binding Id}" Click="Reprint_Click"/>
                                    <Button Style="{StaticResource SoftButton}" Content="PDF" Padding="9,3" Tag="{Binding Id}" Click="SalePdf_Click"/>
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Direita: cliente, total e formas de pagamento -->
        <ScrollViewer Grid.Column="2" Grid.Row="1" Margin="8,16,18,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#E0E6E3" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Cliente" FontSize="14" Foreground="#68766F"/>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="ALTERAR" Padding="9,5" Click="Customer_Click"/>
                            <StackPanel><TextBlock x:Name="CustomerText" Text="CONSUMIDOR" FontSize="18" FontWeight="Bold" Foreground="#1F2C26"/><TextBlock Text="Cliente da venda atual" FontSize="12" Foreground="#87928C"/></StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Background="#0B6B3A" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TOTAL DA VENDA" FontSize="15" FontWeight="SemiBold" Foreground="#DDF2E4"/>
                        <TextBlock x:Name="TotalText" Text="R$ 0,00" FontSize="48" FontWeight="Bold" Foreground="White" TextAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E0E6E3" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Forma de Pagamento" FontSize="18" FontWeight="Bold" Foreground="#243129" Margin="3,0,0,9"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource PaymentButton}" Background="#EAF8EF" Foreground="#087233" Content="💵  Dinheiro" Click="PayCash_Click"/>
                            <Button Style="{StaticResource PaymentButton}" Background="#E8F8F8" Foreground="#0B8D90" Content="◆  PIX" Click="PayPix_Click"/>
                            <Button Style="{StaticResource PaymentButton}" Background="#EEF6FF" Foreground="#1767B0" Content="▰  Débito" Click="PayDebit_Click"/>
                            <Button Style="{StaticResource PaymentButton}" Background="#FFF6E8" Foreground="#B56A00" Content="▰  Crédito" Click="PayCredit_Click"/>
                            <Button Style="{StaticResource PaymentButton}" Background="#F4F1FF" Foreground="#5E4A9A" Content="▤  Crediário" Click="PayStoreCredit_Click"/>
                            <Button Style="{StaticResource PaymentButton}" Background="#EFF2F1" Foreground="#33433B" Content="⇄  Misto" Click="Pay_Click"/>
                        </UniformGrid>
                        <Button Style="{StaticResource RoundedButton}" Content="FINALIZAR / PAGAMENTO  [F2]" FontSize="18" Margin="3,10,3,3" Click="Pay_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="#F2F8F4" BorderBrush="#D8EADB" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Crediário" FontSize="17" FontWeight="Bold" Foreground="#0A6A39"/>
                        <TextBlock Text="Consultar saldo, vencidos, receber parcelas e gerar extrato." TextWrapping="Wrap" Foreground="#53645B" Margin="0,5,0,8"/>
                        <Button Style="{StaticResource RoundedButton}" Content="ABRIR ÁREA DE CREDIÁRIO" Click="Credit_Click"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2">
                    <Button Style="{StaticResource SoftButton}" Content="Impressora" Click="Printer_Click"/>
                    <Button Style="{StaticResource SoftButton}" Content="Diagnóstico" Click="Diagnostic_Click"/>
                    <Button Style="{StaticResource SoftButton}" Content="Caixa" Click="Operations_Click"/>
                    <Button Style="{StaticResource SoftButton}" Content="Compras" Click="Purchases_Click"/>
                    <Button Style="{StaticResource SoftButton}" Content="Calculadora [F5]" Click="Calculator_Click"/>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé -->
        <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Background="White" BorderBrush="#E1E7E4" BorderThickness="0,1,0,0">
            <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ATALHOS  F1 Produto   F2 Pagamento   F3 Consultar   F4 Diversos   F5 Calculadora   F8 Última venda   ESC Cancelar" FontSize="11" FontWeight="SemiBold" Foreground="#3D5147"/>
                    <TextBlock x:Name="RecoveryText" Foreground="#B16E00" FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Caixa 001  •  Administrador  •  " Foreground="#67756E" FontSize="11"/>
                    <TextBlock x:Name="DatabaseStatus" Foreground="#67756E" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

