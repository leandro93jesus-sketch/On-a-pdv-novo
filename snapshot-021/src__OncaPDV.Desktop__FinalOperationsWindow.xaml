<Window x:Class="OncaPDV.Desktop.FinalOperationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Operações finais — ONÇA PDV PRO" Width="1180" Height="760" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterOwner" Background="#F7F9F8" FontFamily="Segoe UI">
 <Grid Margin="16"><TabControl>
  <TabItem Header="VENDAS EM ESPERA"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Vendas em espera" FontSize="22" FontWeight="Bold" Foreground="#0B6B3A"/><DataGrid x:Name="HoldsGrid" Grid.Row="1" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Identificação" Binding="{Binding Label}" Width="2*"/><DataGridTextColumn Header="Criada em" Binding="{Binding CreatedAt}" Width="*"/><DataGridTextColumn Header="Itens" Binding="{Binding Items.Count}" Width="90"/><DataGridTextColumn Header="Total" Binding="{Binding Total,StringFormat=C}" Width="120"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="EXCLUIR ESPERA" Width="150" Height="42" Margin="0,0,8,0" Click="DeleteHold_Click"/><Button Content="RECUPERAR NO CARRINHO" Width="210" Height="42" Background="#0B6B3A" Foreground="White" FontWeight="Bold" Click="RecoverHold_Click"/></StackPanel></Grid></TabItem>
  <TabItem Header="DESPESAS"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="720"><TextBlock Text="Despesa do caixa" FontSize="22" FontWeight="Bold" Foreground="#0B6B3A"/><TextBlock Text="Descrição" Margin="0,18,0,4"/><TextBox x:Name="ExpenseDescription" MinHeight="42"/><TextBlock Text="Valor" Margin="0,14,0,4"/><TextBox x:Name="ExpenseAmount" MinHeight="42"/><Button Content="REGISTRAR DESPESA" Height="50" Margin="0,18,0,0" Background="#0B6B3A" Foreground="White" FontWeight="Bold" Click="Expense_Click"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="DEVOLUÇÃO"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="720"><TextBlock Text="Devolução de mercadoria" FontSize="22" FontWeight="Bold" Foreground="#0B6B3A"/><TextBlock Text="ID da venda" Margin="0,18,0,4"/><TextBox x:Name="ReturnSale"/><TextBlock Text="ID do produto" Margin="0,12,0,4"/><TextBox x:Name="ReturnProduct"/><TextBlock Text="Quantidade" Margin="0,12,0,4"/><TextBox x:Name="ReturnQty"/><TextBlock Text="Motivo" Margin="0,12,0,4"/><TextBox x:Name="ReturnReason"/><Button Content="CONFIRMAR DEVOLUÇÃO" Height="50" Margin="0,18,0,0" Background="#0B6B3A" Foreground="White" FontWeight="Bold" Click="Return_Click"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="TROCA"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="720"><TextBlock Text="Troca de produto" FontSize="22" FontWeight="Bold" Foreground="#0B6B3A"/><TextBlock Text="ID da venda" Margin="0,18,0,4"/><TextBox x:Name="ExchangeSale"/><TextBlock Text="Produto devolvido (ID)" Margin="0,12,0,4"/><TextBox x:Name="ExchangeOld"/><TextBlock Text="Qtd devolvida" Margin="0,12,0,4"/><TextBox x:Name="ExchangeOldQty"/><TextBlock Text="Novo produto (ID)" Margin="0,12,0,4"/><TextBox x:Name="ExchangeNew"/><TextBlock Text="Qtd nova" Margin="0,12,0,4"/><TextBox x:Name="ExchangeNewQty"/><TextBlock Text="Motivo" Margin="0,12,0,4"/><TextBox x:Name="ExchangeReason"/><Button Content="CONFIRMAR TROCA" Height="50" Margin="0,18,0,0" Background="#0B6B3A" Foreground="White" FontWeight="Bold" Click="Exchange_Click"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="HISTÓRICO DETALHADO"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button Content="HOJE" Width="90" Height="38" Click="Today_Click"/><Button Content="ONTEM" Width="90" Height="38" Margin="6,0" Click="Yesterday_Click"/><Button Content="MÊS" Width="90" Height="38" Click="Month_Click"/><TextBox x:Name="SearchBox" Width="280" Height="38" Margin="16,0,6,0" ToolTip="Cliente, produto, venda ou pagamento"/><Button Content="FILTRAR" Width="100" Height="38" Click="Filter_Click"/></WrapPanel><TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,12" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><DataGrid x:Name="HistoryGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Venda" Binding="{Binding Number}" Width="80"/><DataGridTextColumn Header="Data/Hora" Binding="{Binding CreatedAt}" Width="150"/><DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="180"/><DataGridTextColumn Header="Produtos" Binding="{Binding Products}" Width="3*"/><DataGridTextColumn Header="Pagamentos" Binding="{Binding Payments}" Width="2*"/><DataGridTextColumn Header="Total" Binding="{Binding Total,StringFormat=C}" Width="110"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="3" Margin="0,10,0,0" Text="Use a tela Gerenciar vendas para Ver, PDF e Reimprimir. A reimpressão continua pedindo confirmação antes da impressora." Foreground="#65736B"/></Grid></TabItem>
 </TabControl></Grid>
</Window>
