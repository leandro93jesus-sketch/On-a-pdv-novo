<Window x:Class="OncaPDV.Desktop.ReceiptSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dados do comprovante não fiscal"
        Width="760" Height="760" MinWidth="700" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="BorderBrush" Value="#D7E0DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#33433B"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0B6B3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="DADOS DO COMPROVANTE" FontSize="27" FontWeight="Bold" Foreground="#173D29"/>
            <TextBlock Text="Estes dados aparecem no comprovante NÃO FISCAL impresso e na prévia. Poderão ser reaproveitados na configuração fiscal futuramente."
                       TextWrapping="Wrap" Foreground="#68776F" Margin="0,5,0,16"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,4,8,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                    <TextBlock Text="NOME FANTASIA / NOME PRINCIPAL" FontWeight="Bold"/>
                    <TextBox x:Name="FantasyName"/>
                    <TextBlock Text="RAZÃO SOCIAL (opcional)" FontWeight="Bold"/>
                    <TextBox x:Name="LegalName"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="CNPJ" FontWeight="Bold"/>
                    <TextBox x:Name="Cnpj" MaxLength="18"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="INSCRIÇÃO ESTADUAL" FontWeight="Bold"/>
                    <TextBox x:Name="StateRegistration"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                    <TextBlock Text="TELEFONE / WHATSAPP" FontWeight="Bold"/>
                    <TextBox x:Name="Phone"/>
                    <TextBlock Text="ENDEREÇO - LINHA 1" FontWeight="Bold"/>
                    <TextBox x:Name="AddressLine1"/>
                    <TextBlock Text="ENDEREÇO - LINHA 2 (bairro, cidade, CEP...)" FontWeight="Bold"/>
                    <TextBox x:Name="AddressLine2"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                    <TextBlock Text="MENSAGEM NO RODAPÉ" FontWeight="Bold"/>
                    <TextBox x:Name="FooterMessage"/>
                </StackPanel>

                <Border Grid.Row="4" Grid.ColumnSpan="2" Background="#EAF7EE" BorderBrush="#CEE7D5" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,8,0,8">
                    <TextBlock Text="O comprovante será identificado claramente como NÃO FISCAL. CNPJ e IE só serão impressos se você preencher esses campos."
                               TextWrapping="Wrap" Foreground="#1C6740" FontWeight="SemiBold"/>
                </Border>

                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" x:Name="Status" TextWrapping="Wrap" Foreground="#9B6500" FontWeight="SemiBold" Margin="0,4,0,0"/>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="VISUALIZAR" Style="{StaticResource PrimaryButton}" Background="#EDF2EF" Foreground="#26342E" Click="Preview_Click"/>
            <Button Content="SALVAR DADOS" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            <Button Content="FECHAR" Style="{StaticResource PrimaryButton}" Background="#5F6B65" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
