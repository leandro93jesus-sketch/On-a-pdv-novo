<Window x:Class="OncaPDV.Desktop.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pagamento"
        Width="980" Height="720" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9F8"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,11"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#0B6B3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="#EDF2EF"/>
            <Setter Property="Foreground" Value="#2C3A33"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7ECE9"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F5F3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Finalizar Pagamento" FontSize="27" FontWeight="Bold" Foreground="#1E2B24"/>
                <TextBlock Text="Em dinheiro, digite o valor entregue pelo cliente. O troco é calculado na hora." Foreground="#6F7C75" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF7EE" CornerRadius="9" Padding="12,8" VerticalAlignment="Center">
                <TextBlock Text="Pagamento misto disponível" Foreground="#0A6B38" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,14">
            <Border Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="TOTAL DA VENDA" Foreground="#75827B" FontWeight="SemiBold"/><TextBlock x:Name="TotalText" FontSize="31" FontWeight="Bold" Foreground="#17231D" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0">
                <StackPanel><TextBlock Text="TOTAL ALOCADO" Foreground="#75827B" FontWeight="SemiBold"/><TextBlock x:Name="AllocatedText" FontSize="29" FontWeight="Bold" Foreground="#1767B0" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="#FFF8EA" BorderBrush="#F2E3B8" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                <StackPanel><TextBlock Text="VALOR RESTANTE" Foreground="#8A6920" FontWeight="SemiBold"/><TextBlock x:Name="RemainingText" FontSize="29" FontWeight="Bold" Foreground="#9B6500" Margin="0,3,0,0"/></StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="FORMAS DE PAGAMENTO" FontSize="16" FontWeight="Bold" Foreground="#26342D" Margin="6,4,0,10"/>
                    <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CellEditEnding="Grid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="FORMA" Width="220" SelectedItemBinding="{Binding Method,UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="VALOR DESTINADO (R$)" Width="*" Binding="{Binding Amount,UpdateSourceTrigger=PropertyChanged,StringFormat=N2}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource RoundedButton}" Content="+ ADICIONAR FORMA" Click="Add_Click"/>
                        <Button Style="{StaticResource SoftButton}" Content="REMOVER SELECIONADA" Click="Remove_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <Border x:Name="CashPanel" Background="#EAF8EF" BorderBrush="#BFDCC8" BorderThickness="2" CornerRadius="12" Padding="17" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="VALOR ENTREGUE PELO CLIENTE" FontSize="15" FontWeight="Bold" Foreground="#28573B"/>
                        <TextBlock Text="Digite aqui quando o pagamento tiver dinheiro" FontSize="12" Foreground="#6A7A71" Margin="0,2,0,7"/>
                        <TextBox x:Name="CashReceivedInput"
                                 FontSize="31" FontWeight="Bold" Foreground="#087233"
                                 HorizontalContentAlignment="Right"
                                 Padding="10,8" BorderBrush="#72B98A" BorderThickness="2"
                                 TextChanged="CashReceivedInput_TextChanged"
                                 GotKeyboardFocus="CashReceivedInput_GotKeyboardFocus"/>
                        <UniformGrid Columns="4" Margin="0,8,0,0">
                            <Button Style="{StaticResource SoftButton}" Content="EXATO" Tag="EXACT" Click="CashQuick_Click" Padding="6,8"/>
                            <Button Style="{StaticResource SoftButton}" Content="20" Tag="20" Click="CashQuick_Click" Padding="6,8"/>
                            <Button Style="{StaticResource SoftButton}" Content="50" Tag="50" Click="CashQuick_Click" Padding="6,8"/>
                            <Button Style="{StaticResource SoftButton}" Content="100" Tag="100" Click="CashQuick_Click" Padding="6,8"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="#DFF5E6" BorderBrush="#A9DABB" BorderThickness="2" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TROCO" FontSize="18" FontWeight="Bold" Foreground="#155C31"/>
                        <TextBlock x:Name="ChangeText" FontSize="49" FontWeight="Bold" Foreground="#06752F" TextAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="PaymentHintText" Text="Informe os valores e confirme." TextWrapping="Wrap" Foreground="#69766F"/>
                        <TextBlock Text="ENTER confirma • ESC cancela" FontSize="12" Foreground="#8A9690" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Button Style="{StaticResource SoftButton}" Content="CANCELAR  [ESC]" IsCancel="True" HorizontalAlignment="Left" Width="165"/>
            <Button Grid.Column="1" x:Name="ConfirmButton" Style="{StaticResource RoundedButton}" Content="CONFIRMAR PAGAMENTO  [ENTER]" FontSize="18" Padding="20,15" Click="Confirm_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
