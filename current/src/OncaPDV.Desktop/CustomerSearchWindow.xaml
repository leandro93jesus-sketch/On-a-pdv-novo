<Window x:Class="OncaPDV.Desktop.CustomerSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clientes" Width="980" Height="640" WindowStartupLocation="CenterOwner"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBox x:Name="Query" FontSize="18" Padding="8" KeyDown="Query_KeyDown" ToolTip="Nome, telefone, CPF ou CNPJ"/><Button Content="PESQUISAR" Click="Search_Click"/><Button Content="NOVO CLIENTE" Click="New_Click"/></DockPanel><DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Select_Click"><DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Telefone" Binding="{Binding Phone}" Width="145"/><DataGridTextColumn Header="CPF" Binding="{Binding Cpf}" Width="130"/><DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj}" Width="155"/><DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Active}" Width="60"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="EDITAR" Click="Edit_Click"/><Button Content="ATIVAR / INATIVAR" Click="Toggle_Click"/><Button Content="HISTÓRICO" Click="History_Click"/><Button Content="CREDIÁRIO" Click="Credit_Click"/><Button x:Name="SelectButton" Content="SELECIONAR" Click="Select_Click"/></StackPanel></Grid></Window>
