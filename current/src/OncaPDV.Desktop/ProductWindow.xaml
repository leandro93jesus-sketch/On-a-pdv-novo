<Window x:Class="OncaPDV.Desktop.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Produto"
        Width="820" Height="720" MinWidth="760" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9F8"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Background" Value="#0B6B3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D7E0DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#37463E"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="📦  Produto" FontSize="28" FontWeight="Bold" Foreground="#173D2A"/>
            <TextBlock Text="Cadastre com rapidez. Produtos podem ter o mesmo nome; código interno e código de barras devem ser únicos." FontSize="14" Foreground="#6F7B75" Margin="2,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#EEF6FF" BorderBrush="#D6E5F6" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,16,0,12">
            <TextBlock Text="Nomes iguais ou parecidos são permitidos. Se o código interno ou código de barras já existir, o sistema deve bloquear e informar qual produto já usa o código." TextWrapping="Wrap" Foreground="#345A81"/>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="6">
                        <TextBlock Text="Código interno *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="Code"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6">
                        <TextBlock Text="Código de barras" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="Barcode"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="6">
                        <TextBlock Text="Nome do produto *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ProductName"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="6">
                        <TextBlock Text="Descrição" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="Description"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="6">
                        <TextBlock Text="Categoria" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="Category"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="6">
                        <TextBlock Text="Marca" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="Brand"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="6">
                        <TextBlock Text="Unidade *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="Unit" Text="UN"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="6">
                        <TextBlock Text="Estoque inicial" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="Stock" Text="0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="6">
                        <TextBlock Text="Custo (R$)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="Cost" Text="0,00"/>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="6">
                        <TextBlock Text="Preço de venda (R$) *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="Price" Text="0,00"/>
                    </StackPanel>

                    <Border Grid.Row="6" Grid.ColumnSpan="2" Background="#F4F7F5" CornerRadius="8" Padding="12" Margin="6,10,6,2">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="Active" Content="Produto ativo" IsChecked="True" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="   Produtos inativos permanecem no histórico e podem ser exibidos pelo filtro de status." VerticalAlignment="Center" Foreground="#6E7A74" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
            <Button Content="CANCELAR" IsCancel="True" HorizontalAlignment="Left" Width="130" Padding="14,10" Background="#EDF2EF" Foreground="#334239" BorderThickness="0"/>
            <Button Grid.Column="1" Style="{StaticResource RoundedButton}" Content="SALVAR PRODUTO  [F9]" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
