<Window x:Class="OncaPDV.Desktop.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Produto"
        Width="980" Height="850" MinWidth="900" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="#F7F9F8" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0B6B3A"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="3"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EDF2EF"/><Setter Property="Foreground" Value="#26342E"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#D7E0DB"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="DatePicker"><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="📦  PRODUTO" FontSize="28" FontWeight="Bold" Foreground="#173D29"/>
                <TextBlock Text="Nome pode repetir. Código interno e código de barras permanecem únicos." Foreground="#6B7972"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF7EE" CornerRadius="9" Padding="12,8">
                <TextBlock x:Name="MarginText" Text="Margem: 0%" Foreground="#0B6B3A" FontWeight="Bold" FontSize="16"/>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,12">
            <StackPanel>
                <Border Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="5"><TextBlock Text="Código interno *" FontWeight="SemiBold"/><TextBox x:Name="Code"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5"><TextBlock Text="Código de barras"/><TextBox x:Name="Barcode"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="5"><TextBlock Text="Nome do produto *" FontWeight="SemiBold"/><TextBox x:Name="ProductName"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="5"><TextBlock Text="Descrição"/><TextBox x:Name="Description"/></StackPanel>
                        <StackPanel Grid.Row="3" Margin="5"><TextBlock Text="Categoria"/><TextBox x:Name="Category"/></StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="5"><TextBlock Text="Marca"/><TextBox x:Name="Brand"/></StackPanel>
                        <StackPanel Grid.Row="4" Margin="5"><TextBlock Text="Fornecedor principal"/><TextBox x:Name="Supplier"/></StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="5"><TextBlock Text="Localização / prateleira"/><TextBox x:Name="Location"/></StackPanel>
                        <StackPanel Grid.Row="5" Margin="5"><TextBlock Text="Unidade *"/><TextBox x:Name="Unit" Text="UN"/></StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="5"><TextBlock Text="Estoque mínimo"/><TextBox x:Name="MinimumStock" Text="0"/></StackPanel>
                        <StackPanel Grid.Row="6" Margin="5"><TextBlock Text="Estoque inicial"/><TextBox x:Name="Stock" Text="0"/></StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="1" Margin="5"><TextBlock Text="Foto do produto"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PhotoPathBox" IsReadOnly="True"/><Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="ESCOLHER" Click="Photo_Click" Margin="6,0,0,0"/></Grid></StackPanel>
                        <StackPanel Grid.Row="7" Margin="5"><TextBlock Text="Custo (R$)"/><TextBox x:Name="Cost" Text="0,00" TextChanged="PriceChanged"/></StackPanel>
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="5"><TextBlock Text="Preço de venda (R$) *"/><TextBox x:Name="Price" Text="0,00" TextChanged="PriceChanged"/></StackPanel>
                    </Grid>
                </Border>

                <Border Background="#FFF9EC" BorderBrush="#EED9A5" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="5"><TextBlock Text="Preço promocional (R$)" FontWeight="SemiBold"/><TextBox x:Name="PromoPrice"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5"><TextBlock Text="Início da promoção"/><DatePicker x:Name="PromoStart"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="5"><TextBlock Text="Fim da promoção"/><DatePicker x:Name="PromoEnd"/></StackPanel>
                    </Grid>
                </Border>

                <Border Background="#F2F8F4" BorderBrush="#D7E9DC" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <CheckBox x:Name="Active" Content="Produto ativo" IsChecked="True" FontWeight="SemiBold"/>
                            <TextBlock Text="Produtos inativos continuam preservados no histórico. Alterar cadastro não apaga estoque." Foreground="#65756C" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="🏷 PRÉVIA / IMPRIMIR ETIQUETA" Click="Label_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="#A3392F" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SoftButton}" Content="CANCELAR" IsCancel="True"/>
                <Button Style="{StaticResource PrimaryButton}" Content="SALVAR PRODUTO [F9]" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>