<Window x:Class="OncaPDV.Desktop.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Produto" Width="980" Height="820" MinWidth="900" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="#F7F9F8" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#0B6B3A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="Soft" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#EDF2EF"/><Setter Property="Foreground" Value="#26342E"/></Style>
        <Style TargetType="TextBox"><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="BorderBrush" Value="#D7E0DB"/></Style>
        <Style TargetType="DatePicker"><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#37463E"/></Style>
    </Window.Resources>

    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="📦  CADASTRO DE PRODUTO" FontSize="27" FontWeight="Bold" Foreground="#173D29"/><TextBlock Text="Nome pode repetir. Código interno e código de barras continuam únicos. Estoque de produto existente é protegido." Foreground="#68776F" Margin="0,4,0,12"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
                <StackPanel Margin="5"><TextBlock Text="Código interno *" FontWeight="SemiBold"/><TextBox x:Name="Code"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="5"><TextBlock Text="Código de barras" FontWeight="SemiBold"/><TextBox x:Name="Barcode"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="5"><TextBlock Text="Nome do produto *" FontWeight="SemiBold"/><TextBox x:Name="ProductName"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="5"><TextBlock Text="Descrição" FontWeight="SemiBold"/><TextBox x:Name="Description"/></StackPanel>
                <StackPanel Grid.Row="3" Margin="5"><TextBlock Text="Categoria" FontWeight="SemiBold"/><TextBox x:Name="Category"/></StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="5"><TextBlock Text="Marca" FontWeight="SemiBold"/><TextBox x:Name="Brand"/></StackPanel>
                <StackPanel Grid.Row="4" Margin="5"><TextBlock Text="Fornecedor principal" FontWeight="SemiBold"/><TextBox x:Name="Supplier"/></StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="5"><TextBlock Text="Localização / prateleira" FontWeight="SemiBold"/><TextBox x:Name="Shelf" ToolTip="Ex.: Corredor A / Prateleira 03"/></StackPanel>
                <StackPanel Grid.Row="5" Margin="5"><TextBlock Text="Unidade *" FontWeight="SemiBold"/><TextBox x:Name="Unit" Text="UN"/></StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="5"><TextBlock Text="Estoque mínimo" FontWeight="SemiBold"/><TextBox x:Name="MinimumStock" Text="0"/></StackPanel>
                <StackPanel Grid.Row="6" Margin="5"><TextBlock Text="Estoque inicial" FontWeight="SemiBold"/><TextBox x:Name="Stock" Text="0"/></StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="1" Margin="5"><TextBlock Text="Custo (R$)" FontWeight="SemiBold"/><TextBox x:Name="Cost" Text="0,00" TextChanged="Price_TextChanged"/></StackPanel>
                <StackPanel Grid.Row="7" Margin="5"><TextBlock Text="Preço de venda (R$) *" FontWeight="SemiBold"/><TextBox x:Name="Price" Text="0,00" TextChanged="Price_TextChanged"/></StackPanel>
                <Border Grid.Row="7" Grid.Column="1" Background="#EAF7EE" CornerRadius="8" Padding="10" Margin="5"><StackPanel><TextBlock Text="MARGEM ESTIMADA" FontSize="11" Foreground="#587364"/><TextBlock x:Name="MarginText" Text="0,00%" FontSize="24" FontWeight="Bold" Foreground="#0B6B3A"/></StackPanel></Border>
                <Border Grid.Row="8" Grid.ColumnSpan="2" Background="#F4F7F5" CornerRadius="8" Padding="12" Margin="5"><StackPanel Orientation="Horizontal"><CheckBox x:Name="Active" Content="Produto ativo" IsChecked="True" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="   Desativar não apaga histórico." Foreground="#6E7A74" VerticalAlignment="Center"/></StackPanel></Border>
            </Grid></Border>

            <StackPanel Grid.Column="1">
                <Border Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="FOTO DO PRODUTO" FontWeight="Bold" FontSize="16"/><Border Height="150" Background="#F3F6F4" CornerRadius="8" Margin="0,9"><Image x:Name="ProductImage" Stretch="Uniform"/></Border><TextBlock x:Name="PhotoPathText" Text="Nenhuma foto selecionada" TextWrapping="Wrap" Foreground="#6E7A74" FontSize="12"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Soft}" Content="ESCOLHER FOTO" Click="Photo_Click"/><Button Style="{StaticResource Soft}" Content="REMOVER" Click="RemovePhoto_Click"/></StackPanel></StackPanel></Border>
                <Border Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="PREÇO PROMOCIONAL" FontWeight="Bold" FontSize="16"/><TextBlock Text="Preço promocional (R$)"/><TextBox x:Name="PromotionalPrice"/><TextBlock Text="Início"/><DatePicker x:Name="PromotionStart"/><TextBlock Text="Fim"/><DatePicker x:Name="PromotionEnd"/><TextBlock Text="A promoção entra e sai automaticamente pelas datas definidas." TextWrapping="Wrap" FontSize="12" Foreground="#6E7A74"/></StackPanel></Border>
            </StackPanel>
        </Grid></ScrollViewer>
        <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#6E7A74"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource Soft}" Content="CANCELAR" IsCancel="True"/><Button Style="{StaticResource Primary}" Content="SALVAR [F9]" Click="Save_Click"/></StackPanel></Grid>
    </Grid>
</Window>