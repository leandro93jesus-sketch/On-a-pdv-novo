<Window x:Class="OncaPDV.Desktop.SaleManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Histórico e Correção de Vendas" Width="1320" Height="790" MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterOwner" Background="#F7F9F8" FontFamily="Segoe UI">
<Window.Resources>
<Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#0B6B3A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="3"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style x:Key="Soft" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#EDF2EF"/><Setter Property="Foreground" Value="#26342E"/></Style>
<Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#B3261E"/></Style>
<Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="RowHeight" Value="42"/><Setter Property="FontSize" Value="13"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E7ECE9"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F5F3"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/></Style>
</Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HISTÓRICO DE VENDAS" FontSize="28" FontWeight="Bold" Foreground="#173D29"/><TextBlock Text="Consulte, reimprima, gere PDF, cancele ou prepare uma correção. Ações críticas exigem PIN de administrador e ficam auditadas." Foreground="#6B7972"/></StackPanel><Button Grid.Column="1" Style="{StaticResource Soft}" Content="ATUALIZAR" Click="Refresh_Click"/></Grid>
<Grid Grid.Row="1" Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<DatePicker x:Name="From"/><DatePicker Grid.Column="1" x:Name="To" Margin="8,0,0,0"/><TextBox Grid.Column="2" x:Name="Search" Margin="8,0" Padding="10,7" FontSize="15" ToolTip="Venda, cliente, produto ou código" KeyDown="Search_KeyDown"/>
<ComboBox Grid.Column="3" x:Name="Payment" Margin="4,0" Padding="7"><ComboBoxItem Content="Todos pagamentos" Tag="Todos" IsSelected="True"/><ComboBoxItem Content="Dinheiro" Tag="Cash"/><ComboBoxItem Content="PIX" Tag="Pix"/><ComboBoxItem Content="Débito" Tag="Debit"/><ComboBoxItem Content="Crédito" Tag="Credit"/><ComboBoxItem Content="Crediário" Tag="StoreCredit"/></ComboBox>
<ComboBox Grid.Column="4" x:Name="Status" Margin="4,0" Padding="7"><ComboBoxItem Content="Concluídas" Tag="Concluidas" IsSelected="True"/><ComboBoxItem Content="Canceladas" Tag="Canceladas"/><ComboBoxItem Content="Todas" Tag="Todos"/></ComboBox><Button Grid.Column="5" Style="{StaticResource Primary}" Content="CONSULTAR" Click="Refresh_Click"/>
</Grid>
<Border Grid.Row="2" Background="White" BorderBrush="#DDE5E1" BorderThickness="1" CornerRadius="10" Padding="8"><DataGrid x:Name="Grid" SelectionMode="Single" MouseDoubleClick="Grid_DoubleClick"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="CANCELADA"><Setter Property="Background" Value="#FFF0EE"/><Setter Property="Foreground" Value="#A12620"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns>
<DataGridTextColumn Header="VENDA" Binding="{Binding Number,StringFormat=000000}" Width="75"/><DataGridTextColumn Header="DATA/HORA" Binding="{Binding CreatedAt,StringFormat=dd/MM/yyyy HH:mm:ss}" Width="145"/><DataGridTextColumn Header="CLIENTE" Binding="{Binding Customer}" Width="180"/><DataGridTextColumn Header="PRODUTOS" Binding="{Binding Products}" Width="310"/><DataGridTextColumn Header="QTD" Binding="{Binding ItemQuantity,StringFormat=N2}" Width="65"/><DataGridTextColumn Header="TOTAL" Binding="{Binding Total,StringFormat=C}" Width="100"/><DataGridTextColumn Header="RECEBIDO" Binding="{Binding CashReceived,StringFormat=C}" Width="100"/><DataGridTextColumn Header="TROCO" Binding="{Binding Change,StringFormat=C}" Width="90"/><DataGridTextColumn Header="PAGAMENTOS" Binding="{Binding Payments}" Width="260"/><DataGridTextColumn Header="OPERADOR" Binding="{Binding Operator}" Width="90"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="105"/></DataGrid.Columns></DataGrid></Border>
<Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Info" VerticalAlignment="Center" Foreground="#637169"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource Soft}" Content="VER VENDA" Click="Details_Click"/><Button Style="{StaticResource Soft}" Content="PDF" Click="Pdf_Click"/><Button Style="{StaticResource Soft}" Content="REIMPRIMIR" Click="Reprint_Click"/><Button Style="{StaticResource Danger}" Content="CANCELAR COM SENHA" Click="Cancel_Click"/><Button Style="{StaticResource Primary}" Background="#B56A00" Content="CORRIGIR COM SENHA" Click="Correct_Click"/></StackPanel></Grid>
</Grid></Window>