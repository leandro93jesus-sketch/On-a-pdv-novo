<Window x:Class="OncaPDV.Desktop.StockControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controle de Estoque" Width="900" Height="680" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F7F9F8" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="#0B6B3A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="3"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#EDF2EF"/><Setter Property="Foreground" Value="#26342E"/></Style>
        <Style TargetType="TextBox"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#D8E1DC"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E7ECE9"/><Setter Property="RowHeight" Value="40"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F5F3"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    </Window.Resources>
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CONTROLE DE ESTOQUE" FontSize="26" FontWeight="Bold" Foreground="#173D29"/><TextBlock x:Name="ProductText" FontSize="18" FontWeight="SemiBold" Foreground="#34423C" Margin="0,4,0,0"/><TextBlock x:Name="CodeText" Foreground="#718078"/></StackPanel><Border Grid.Column="1" Background="#EAF7EE" BorderBrush="#CBE5D3" BorderThickness="1" CornerRadius="10" Padding="15,10"><StackPanel><TextBlock Text="ESTOQUE ATUAL" Foreground="#3C6C4B" FontWeight="SemiBold"/><TextBlock x:Name="CurrentText" FontSize="32" FontWeight="Bold" Foreground="#087233" HorizontalAlignment="Right"/></StackPanel></Border></Grid>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,12"><Border Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="9" Padding="10" Margin="3"><StackPanel><TextBlock Text="MÍNIMO" Foreground="#718078"/><TextBlock x:Name="MinimumText" FontSize="19" FontWeight="Bold"/></StackPanel></Border><Border Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="9" Padding="10" Margin="3"><StackPanel><TextBlock Text="CUSTO" Foreground="#718078"/><TextBlock x:Name="CostText" FontSize="19" FontWeight="Bold"/></StackPanel></Border><Border Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="9" Padding="10" Margin="3"><StackPanel><TextBlock Text="VENDA" Foreground="#718078"/><TextBlock x:Name="PriceText" FontSize="19" FontWeight="Bold"/></StackPanel></Border><Border Background="#F2F8F4" CornerRadius="9" Padding="10" Margin="3"><StackPanel><TextBlock Text="STATUS" Foreground="#718078"/><TextBlock x:Name="StatusText" FontSize="18" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
        <Border Grid.Row="2" Background="#F2F8F4" BorderBrush="#CFE5D6" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="CONTAGEM FÍSICA / NOVO ESTOQUE" FontSize="11" FontWeight="SemiBold" Foreground="#557064"/><TextBox x:Name="QuantityInput" FontSize="25" FontWeight="Bold" HorizontalContentAlignment="Right"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="MOTIVO DO AJUSTE" FontSize="11" FontWeight="SemiBold" Foreground="#557064"/><TextBox x:Name="ReasonInput" ToolTip="Ex.: inventário, quebra, acerto de contagem"/></StackPanel><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="APLICAR AJUSTE" Click="Apply_Click" VerticalAlignment="Bottom"/></Grid></Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="10" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="HISTÓRICO DE MOVIMENTAÇÕES" FontSize="17" FontWeight="Bold" Foreground="#173D29" Margin="6,4,0,8"/><DataGrid Grid.Row="1" x:Name="MovementsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="DATA / HORA" Binding="{Binding CreatedAt,StringFormat=dd/MM/yyyy HH:mm:ss}" Width="150"/><DataGridTextColumn Header="TIPO" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="QTD." Binding="{Binding Quantity,StringFormat=N3}" Width="90"/><DataGridTextColumn Header="MOTIVO" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="ORIGEM" Binding="{Binding Origin}" Width="220"/></DataGrid.Columns></DataGrid></Grid></Border>
        <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="MessageText" Foreground="#5E6D65" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="IMPRIMIR ETIQUETA" Click="Label_Click"/><Button Grid.Column="2" Style="{StaticResource SoftButton}" Content="FECHAR" IsCancel="True"/></Grid>
    </Grid>
</Window>