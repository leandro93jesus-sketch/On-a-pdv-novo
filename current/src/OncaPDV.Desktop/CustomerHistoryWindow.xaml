<Window x:Class="OncaPDV.Desktop.CustomerHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cliente e Crediário" Width="1050" Height="690" MinWidth="920" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#F7F9F8" FontFamily="Segoe UI">
<Window.Resources><Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#0B6B3A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="3"/><Setter Property="BorderThickness" Value="0"/></Style><Style x:Key="Soft" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#EDF2EF"/><Setter Property="Foreground" Value="#26342E"/></Style></Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock x:Name="TitleText" FontSize="27" FontWeight="Bold" Foreground="#173D29"/><TextBlock x:Name="ContactText" Foreground="#66746D" Margin="0,4,0,0"/></StackPanel>
<UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,12"><Border Background="#F2F8F4" CornerRadius="9" Padding="13" Margin="3"><StackPanel><TextBlock Text="LIMITE" Foreground="#617069"/><TextBlock x:Name="LimitText" FontSize="23" FontWeight="Bold"/></StackPanel></Border><Border Background="#FFF4F2" CornerRadius="9" Padding="13" Margin="3"><StackPanel><TextBlock Text="EM ABERTO" Foreground="#91423A"/><TextBlock x:Name="OpenText" FontSize="23" FontWeight="Bold" Foreground="#B3261E"/></StackPanel></Border><Border Background="#FFF0EE" CornerRadius="9" Padding="13" Margin="3"><StackPanel><TextBlock Text="VENCIDO" Foreground="#91423A"/><TextBlock x:Name="OverdueText" FontSize="23" FontWeight="Bold" Foreground="#B3261E"/></StackPanel></Border><Border Background="#EAF7EE" CornerRadius="9" Padding="13" Margin="3"><StackPanel><TextBlock Text="DISPONÍVEL" Foreground="#3C6C4B"/><TextBlock x:Name="AvailableText" FontSize="23" FontWeight="Bold" Foreground="#0B6B3A"/></StackPanel></Border></UniformGrid>
<TabControl Grid.Row="2"><TabItem Header="COMPRAS"><DataGrid x:Name="Sales" AutoGenerateColumns="False" IsReadOnly="True" Margin="8"><DataGrid.Columns><DataGridTextColumn Header="VENDA" Binding="{Binding Number,StringFormat=000000}" Width="90"/><DataGridTextColumn Header="DATA" Binding="{Binding CreatedAt,StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="ITENS" Binding="{Binding Items.Count}" Width="70"/><DataGridTextColumn Header="DESCONTO" Binding="{Binding Discount,StringFormat=C}" Width="100"/><DataGridTextColumn Header="TOTAL" Binding="{Binding Total,StringFormat=C}" Width="120"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="CREDIÁRIO"><DataGrid x:Name="Credits" AutoGenerateColumns="False" IsReadOnly="True" Margin="8"><DataGrid.Columns><DataGridTextColumn Header="VENDA" Binding="{Binding SaleNumber,StringFormat=000000}" Width="90"/><DataGridTextColumn Header="ORIGINAL" Binding="{Binding Original,StringFormat=C}" Width="120"/><DataGridTextColumn Header="PAGO" Binding="{Binding Paid,StringFormat=C}" Width="120"/><DataGridTextColumn Header="SALDO" Binding="{Binding Balance,StringFormat=C}" Width="120"/><DataGridTextColumn Header="VENCIMENTO" Binding="{Binding DueAt,StringFormat=dd/MM/yyyy}" Width="120"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
<Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Novo limite:" VerticalAlignment="Center"/><TextBox x:Name="NewLimit" Width="120" Margin="8,0" Padding="8"/><Button Style="{StaticResource Soft}" Content="ALTERAR LIMITE COM SENHA" Click="Limit_Click"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource Soft}" Content="PDF VENDA" Click="Pdf_Click"/><Button Style="{StaticResource Soft}" Content="SEGUNDA VIA" Click="Second_Click"/><Button Style="{StaticResource Primary}" Content="ABRIR CREDIÁRIO" Click="Credit_Click"/></StackPanel></Grid>
</Grid></Window>