<Window x:Class="OncaPDV.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entrar no ONÇA PDV PRO" Width="470" Height="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F6F9F7" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0B6B3A"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,11"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="8"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="FontSize" Value="22"/><Setter Property="Padding" Value="10"/></Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ONÇA PDV PRO" FontSize="31" FontWeight="Bold" Foreground="#09652F" HorizontalAlignment="Center"/>
            <TextBlock Text="Acesso ao sistema" FontSize="17" Foreground="#64736B" HorizontalAlignment="Center" Margin="0,3,0,24"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E1" BorderThickness="1" CornerRadius="12" Padding="22">
            <StackPanel>
                <TextBlock Text="USUÁRIO" FontWeight="SemiBold" Foreground="#4F6258"/>
                <ComboBox x:Name="UserBox" DisplayMemberPath="DisplayName" Margin="0,5,0,17"/>
                <TextBlock Text="PIN" FontWeight="SemiBold" Foreground="#4F6258"/>
                <PasswordBox x:Name="PinBox" MaxLength="12" Margin="0,5,0,12" KeyDown="PinBox_KeyDown"/>
                <Button Content="ENTRAR" Click="Login_Click"/>
                <TextBlock x:Name="StatusText" Foreground="#A3392F" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <Border x:Name="FirstAccessPanel" Background="#FFF7E6" BorderBrush="#EBCF91" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,16,0,0">
                    <TextBlock Text="Primeiro acesso: usuário admin, PIN 1234. O sistema pedirá a troca do PIN." TextWrapping="Wrap" Foreground="#7A5A17"/>
                </Border>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2" Text="Perfis: Administrador • Caixa • Estoque" HorizontalAlignment="Center" Foreground="#718078" Margin="0,16,0,0"/>
    </Grid>
</Window>