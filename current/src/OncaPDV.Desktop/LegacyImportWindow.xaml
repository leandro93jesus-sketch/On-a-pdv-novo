<Window x:Class="OncaPDV.Desktop.LegacyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar backup do PDV antigo"
        Width="980" Height="760" MinWidth="860" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,11"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#0B6B3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="#EDF2EF"/>
            <Setter Property="Foreground" Value="#2D3A34"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="↥  Importar Backup do PDV Antigo" FontSize="28" FontWeight="Bold" Foreground="#173D2A"/>
                <TextBlock Text="Validação em somente leitura, dry-run, backup de segurança e rollback completo." Foreground="#6C7972" Margin="2,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF7EE" CornerRadius="9" Padding="13,8" VerticalAlignment="Center">
                <TextBlock Text="Backup original protegido" Foreground="#0A6B38" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#FFF9E9" BorderBrush="#F0DFAC" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,16,0,12">
            <TextBlock Text="O arquivo escolhido nunca é alterado. Primeiro clique em VALIDAR BACKUP. A importação só é liberada depois do SHA-256 permanecer idêntico e das contagens serem exibidas." TextWrapping="Wrap" Foreground="#705B21"/>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Arquivo SQLite" FontWeight="SemiBold" Foreground="#46534C" Margin="0,0,0,5"/>
                    <TextBox x:Name="SourceFile" IsReadOnly="True" FontSize="15" Padding="10" BorderBrush="#D7E0DB" BorderThickness="1"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="ESCOLHER ARQUIVO" Click="Choose_Click" Margin="12,24,0,0" MinWidth="165"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="RESULTADO DA VALIDAÇÃO / DRY-RUN" FontWeight="Bold" Foreground="#2A3731" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox Grid.Row="1" x:Name="Analysis" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Padding="12" BorderThickness="0" Background="#FBFCFB"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#F1F6F3" BorderBrush="#DCE6E0" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,12,0,8">
            <TextBlock x:Name="Status" Text="Escolha um arquivo e clique em VALIDAR BACKUP." TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#365246"/>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Style="{StaticResource SoftButton}" Content="FECHAR" IsCancel="True" Width="120" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SoftButton}" Content="VER RELATÓRIO" x:Name="ReportButton" Click="Report_Click" IsEnabled="False" MinWidth="150"/>
                <Button Style="{StaticResource RoundedButton}" Content="VALIDAR BACKUP" Click="Validate_Click" MinWidth="170"/>
                <Button Style="{StaticResource RoundedButton}" Background="#075A30" x:Name="ImportButton" Content="IMPORTAR DADOS" Click="Import_Click" IsEnabled="False" MinWidth="180"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
