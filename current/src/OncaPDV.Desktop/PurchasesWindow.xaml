<Window x:Class="OncaPDV.Desktop.PurchasesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Compras e fornecedores" Width="1000" Height="700" WindowStartupLocation="CenterOwner">
 <TabControl Margin="15">
  <TabItem Header="FORNECEDORES"><Grid Margin="15"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><WrapPanel><TextBox x:Name="SupplierName" Width="260" ToolTip="Nome"/><TextBox x:Name="SupplierTax" Width="180" ToolTip="CPF/CNPJ"/><TextBox x:Name="SupplierPhone" Width="160" ToolTip="Telefone"/><Button Content="SALVAR FORNECEDOR" Click="SaveSupplier_Click"/><TextBox x:Name="SupplierSearch" Width="220" ToolTip="Buscar"/><Button Content="BUSCAR" Click="SearchSupplier_Click"/></WrapPanel><DataGrid x:Name="SupplierGrid" Grid.Row="1" Margin="0,12,0,0" AutoGenerateColumns="True" IsReadOnly="True"/></Grid></TabItem>
  <TabItem Header="ENTRADA DE COMPRA"><Grid Margin="15"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="Fornecedor" VerticalAlignment="Center"/><ComboBox x:Name="SupplierCombo" Width="280" DisplayMemberPath="Name"/><TextBox x:Name="DocumentNumber" Width="180" ToolTip="Número do documento"/></WrapPanel><WrapPanel Grid.Row="1" Margin="0,10"><TextBox x:Name="ProductSearch" Width="300" ToolTip="Código ou produto"/><TextBox x:Name="Quantity" Width="100" Text="1" ToolTip="Quantidade"/><TextBox x:Name="UnitCost" Width="130" ToolTip="Custo unitário"/><Button Content="ADICIONAR ITEM" Click="AddItem_Click"/></WrapPanel><DataGrid x:Name="ItemsGrid" Grid.Row="2" AutoGenerateColumns="True" CanUserAddRows="False"/><DockPanel Grid.Row="3" Margin="0,12"><TextBlock x:Name="PurchaseTotal" Text="TOTAL: R$ 0,00" FontSize="24" FontWeight="Bold"/><Button Content="CONFIRMAR ENTRADA" DockPanel.Dock="Right" Click="CompletePurchase_Click"/></DockPanel></Grid></TabItem>
 </TabControl>
</Window>
