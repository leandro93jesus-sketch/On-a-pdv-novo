<Window x:Class="OncaPDV.Desktop.PrinterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações → Impressora por terminal"
        Width="720" Height="780" MinWidth="650" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#F7F9F8" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="9"/></Style>
        <Style TargetType="ComboBox"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="8"/></Style>
        <Style x:Key="Btn" TargetType="Button"><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="15"/></Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26">
            <TextBlock Text="IMPRESSORA DO CAIXA" FontSize="27" FontWeight="Bold" Foreground="#173D29"/>
            <TextBlock Text="Cada terminal pode usar sua própria impressora, papel e codificação." Foreground="#6C7A73" Margin="0,4,0,18"/>

            <TextBlock Text="TERMINAL" FontWeight="Bold"/><TextBox x:Name="TerminalId" Text="CAIXA-01"/>
            <TextBlock Text="IMPRESSORA" FontWeight="Bold" Margin="0,14,0,0"/><ComboBox x:Name="Printers" DisplayMemberPath="QueueName"/>
            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="PAPEL" FontWeight="Bold"/><ComboBox x:Name="Paper"><ComboBoxItem Content="58 mm"/><ComboBoxItem Content="80 mm" IsSelected="True"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="ENCODING" FontWeight="Bold"/><ComboBox x:Name="Encoding"><ComboBoxItem Content="CP850" IsSelected="True"/><ComboBoxItem Content="CP858"/><ComboBoxItem Content="CP860"/></ComboBox></StackPanel>
            </Grid>
            <TextBlock Text="BACKEND" FontWeight="Bold" Margin="0,14,0,0"/><ComboBox x:Name="Backend"><ComboBoxItem Content="EscPosRaw" IsSelected="True"/><ComboBoxItem Content="WindowsDriver"/></ComboBox>

            <Border Background="#EAF7EE" BorderBrush="#BEDFC8" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,18,0,8">
                <StackPanel>
                    <CheckBox x:Name="Physical" Content="ATIVAR IMPRESSÃO FÍSICA NESTE TERMINAL" FontSize="16" FontWeight="Bold" Foreground="#0B6B3A"/>
                    <TextBlock Text="Desmarcado = apenas prévia/mock. Marque somente depois de selecionar a impressora correta." TextWrapping="Wrap" Foreground="#5F7167" Margin="22,4,0,0"/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="Cut" Content="Corte automático após o comprovante" IsChecked="True" Margin="0,8,0,0" FontSize="15"/>
            <CheckBox x:Name="Drawer" Content="Abrir gaveta ao imprimir" Margin="0,8" FontSize="15"/>

            <WrapPanel Margin="0,15,0,0">
                <Button Style="{StaticResource Btn}" Content="SALVAR PERFIL" Background="#0B6B3A" Foreground="White" Click="Save_Click"/>
                <Button Style="{StaticResource Btn}" Content="CARREGAR" Click="Load_Click"/>
                <Button Style="{StaticResource Btn}" Content="VISUALIZAR" Click="Preview_Click"/>
                <Button Style="{StaticResource Btn}" Content="TESTE MOCK" Click="Mock_Click"/>
                <Button Style="{StaticResource Btn}" Content="TESTAR IMPRESSÃO FÍSICA" Background="#245B9C" Foreground="White" Click="PhysicalTest_Click"/>
            </WrapPanel>
            <Border Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,16,0,0">
                <TextBlock x:Name="Status" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
