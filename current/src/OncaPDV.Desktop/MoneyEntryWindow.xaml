<Window x:Class="OncaPDV.Desktop.MoneyEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informar valor" Width="430" Height="330" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F9F8">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" Foreground="#173D29"/>
            <TextBlock x:Name="HintText" Foreground="#6B7972" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="VALOR (R$)" FontWeight="SemiBold"/>
            <TextBox x:Name="ValueBox" FontSize="32" FontWeight="Bold" Padding="10" HorizontalContentAlignment="Right" Margin="0,5,0,10"/>
            <TextBlock x:Name="StatusText" Foreground="#A3392F"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCELAR" IsCancel="True" Padding="14,9" Margin="4"/>
            <Button Content="CONFIRMAR" Click="Confirm_Click" Background="#0B6B3A" Foreground="White" FontWeight="Bold" Padding="16,9" Margin="4"/>
        </StackPanel>
    </Grid>
</Window>