<Window x:Class="OncaPDV.Desktop.SaleDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhes da venda"
        Width="1040" Height="700" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F7F9F8" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7ECE9"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F5F3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="27" FontWeight="Bold" Foreground="#173D29"/>
                <TextBlock x:Name="SubtitleText" Foreground="#68776F" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF7EE" CornerRadius="10" Padding="18,10">
                <StackPanel>
                    <TextBlock Text="TOTAL" Foreground="#4F6E5A" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TotalText" FontSize="28" FontWeight="Bold" Foreground="#0B6B3A"/>
                </StackPanel>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,14">
            <Border Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="9" Padding="12" Margin="3"><StackPanel><TextBlock Text="CLIENTE" Foreground="#738078"/><TextBlock x:Name="CustomerText" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="9" Padding="12" Margin="3"><StackPanel><TextBlock Text="ITENS" Foreground="#738078"/><TextBlock x:Name="ItemsCountText" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="9" Padding="12" Margin="3"><StackPanel><TextBlock Text="DESCONTO" Foreground="#738078"/><TextBlock x:Name="DiscountText" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="9" Padding="12" Margin="3"><StackPanel><TextBlock Text="DINHEIRO RECEBIDO" Foreground="#738078"/><TextBlock x:Name="ReceivedText" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="#EAF7EE" BorderBrush="#CEE5D5" BorderThickness="1" CornerRadius="9" Padding="12" Margin="3"><StackPanel><TextBlock Text="TROCO" Foreground="#4D7359"/><TextBlock x:Name="ChangeText" FontSize="20" FontWeight="Bold" Foreground="#0B6B3A"/></StackPanel></Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="9" Padding="8" Margin="0,0,7,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="PRODUTOS DA VENDA" FontWeight="Bold" Foreground="#173D29" Margin="6,4,0,8"/>
                    <DataGrid Grid.Row="1" x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Code}" Width="95"/>
                            <DataGridTextColumn Header="PRODUTO" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="QTD." Binding="{Binding Quantity,StringFormat=N2}" Width="75"/>
                            <DataGridTextColumn Header="UNITÁRIO" Binding="{Binding UnitPrice,StringFormat=C}" Width="100"/>
                            <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal,StringFormat=C}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="9" Padding="8" Margin="7,0,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="PAGAMENTOS" FontWeight="Bold" Foreground="#173D29" Margin="6,4,0,8"/>
                    <DataGrid Grid.Row="1" x:Name="PaymentsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FORMA" Binding="{Binding Method}" Width="*"/>
                            <DataGridTextColumn Header="VALOR" Binding="{Binding Amount,StringFormat=C}" Width="100"/>
                            <DataGridTextColumn Header="RECEBIDO" Binding="{Binding Received,StringFormat=C}" Width="100"/>
                            <DataGridTextColumn Header="TROCO" Binding="{Binding Change,StringFormat=C}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Row="3" Content="FECHAR" Width="130" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="14,9" IsCancel="True"/>
    </Grid>
</Window>
