<Window x:Class="OncaPDV.Desktop.BarcodeLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etiqueta de Produto" Width="620" Height="520" WindowStartupLocation="CenterOwner" Background="#F7F9F8">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ETIQUETA COM CÓDIGO DE BARRAS" FontSize="24" FontWeight="Bold" Foreground="#173D29"/>
            <TextBlock Text="EAN-13 pronto para impressão. Para outros formatos, use o código interno no comprovante." Foreground="#68766F"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#D9E1DD" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,14">
            <Viewbox Stretch="Uniform">
                <Border x:Name="PrintArea" Width="430" Height="250" Background="White" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="NameText" FontSize="18" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Canvas Grid.Row="1" x:Name="BarcodeCanvas" Width="380" Height="145" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="2" x:Name="BarcodeText" FontFamily="Consolas" FontSize="17" TextAlignment="Center"/>
                        <TextBlock Grid.Row="3" x:Name="PriceText" FontSize="30" FontWeight="Bold" Foreground="#0B6B3A" TextAlignment="Center"/>
                    </Grid>
                </Border>
            </Viewbox>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="FECHAR" IsCancel="True" Padding="14,9" Margin="4"/>
            <Button Content="IMPRIMIR ETIQUETA" Click="Print_Click" Background="#0B6B3A" Foreground="White" FontWeight="Bold" Padding="16,9" Margin="4"/>
        </StackPanel>
    </Grid>
</Window>