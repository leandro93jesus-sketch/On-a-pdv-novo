<Window x:Class="OncaPDV.Desktop.CreditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crediário — ONÇA PDV PRO"
        Width="1420" Height="820" MinWidth="1180" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#0B6B3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="#EDF2EF"/>
            <Setter Property="Foreground" Value="#2E3A34"/>
        </Style>
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="MinWidth" Value="105"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#D7E0DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7ECE9"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFCFB"/>
            <Setter Property="RowHeight" Value="43"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F5F3"/>
            <Setter Property="Foreground" Value="#33413A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="▤  Crediário" FontSize="30" FontWeight="Bold" Foreground="#163A28"/>
                <TextBlock Text="Controle de clientes, saldos, vencimentos e recebimentos." Foreground="#6F7C75" FontSize="14" Margin="2,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF7EE" CornerRadius="9" Padding="13,8" VerticalAlignment="Center">
                <TextBlock x:Name="ActiveFilterText" Text="Filtro: Todos" Foreground="#0A6B38" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,14">
            <Border Background="#FFF4F4" BorderBrush="#F1D3D3" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,7,0">
                <StackPanel><TextBlock Text="TOTAL EM ABERTO" Foreground="#9B3030" FontWeight="SemiBold"/><TextBlock x:Name="TotalOpenText" Text="R$ 0,00" FontSize="29" FontWeight="Bold" Foreground="#D21F26"/></StackPanel>
            </Border>
            <Border Background="#ECF8EF" BorderBrush="#D0E8D5" BorderThickness="1" CornerRadius="10" Padding="15" Margin="3,0,7,0">
                <StackPanel><TextBlock Text="TOTAL RECEBIDO" Foreground="#336A45" FontWeight="SemiBold"/><TextBlock x:Name="TotalPaidText" Text="R$ 0,00" FontSize="29" FontWeight="Bold" Foreground="#16803B"/></StackPanel>
            </Border>
            <Border Background="#FFF5F1" BorderBrush="#F2D8CB" BorderThickness="1" CornerRadius="10" Padding="15" Margin="3,0,7,0">
                <StackPanel><TextBlock Text="VENCIDOS" Foreground="#9A4A2B" FontWeight="SemiBold"/><TextBlock x:Name="OverdueText" Text="0" FontSize="29" FontWeight="Bold" Foreground="#D64320"/></StackPanel>
            </Border>
            <Border Background="#EEF5FF" BorderBrush="#D2E1F5" BorderThickness="1" CornerRadius="10" Padding="15" Margin="3,0,0,0">
                <StackPanel><TextBlock Text="CONTAS / PARCELAS" Foreground="#3E628B" FontWeight="SemiBold"/><TextBlock x:Name="AccountsCountText" Text="0" FontSize="29" FontWeight="Bold" Foreground="#1767B0"/></StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,13">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Buscar cliente por nome"/>
                <WrapPanel Grid.Column="1" Margin="10,0,0,0">
                    <Button Style="{StaticResource FilterButton}" Content="TODOS" Tag="Todos" Click="FilterButton_Click"/>
                    <Button Style="{StaticResource FilterButton}" Content="EM ABERTO" Tag="Open" Click="FilterButton_Click"/>
                    <Button Style="{StaticResource FilterButton}" Content="PARCIAL" Tag="Partial" Click="FilterButton_Click"/>
                    <Button Style="{StaticResource FilterButton}" Content="VENCIDOS" Tag="Overdue" Click="FilterButton_Click"/>
                    <Button Style="{StaticResource FilterButton}" Content="PAGOS" Tag="Paid" Click="FilterButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.25*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>

            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="220"/></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="8">
                    <DataGrid x:Name="Accounts" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Account_Changed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding Customer}" Width="*"/>
                            <DataGridTextColumn Header="VENDA" Binding="{Binding SaleNumber,StringFormat=000000}" Width="90"/>
                            <DataGridTextColumn Header="ORIGINAL" Binding="{Binding Original,StringFormat=C}" Width="110"/>
                            <DataGridTextColumn Header="PAGO" Binding="{Binding Paid,StringFormat=C}" Width="105"/>
                            <DataGridTextColumn Header="SALDO" Binding="{Binding Balance,StringFormat=C}" Width="110"/>
                            <DataGridTextColumn Header="VENCIMENTO" Binding="{Binding DueAt,StringFormat=dd/MM/yyyy}" Width="115"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="ÚLTIMOS RECEBIMENTOS / MOVIMENTOS" FontWeight="Bold" Foreground="#2A3731" VerticalAlignment="Center" Margin="5,0"/>
                        <DataGrid Grid.Row="1" x:Name="Movements" IsReadOnly="True" AutoGenerateColumns="True" RowHeight="35" FontSize="13"/>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1">
                <Border Background="White" BorderBrush="#DCE4E0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DETALHES DO CLIENTE / CONTA" FontWeight="Bold" Foreground="#33423A"/>
                        <TextBlock x:Name="SelectedCustomerText" Text="Selecione uma conta" FontSize="22" FontWeight="Bold" Foreground="#183226" Margin="0,10,0,2" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedSaleText" Text="Venda: —" Foreground="#6F7B75"/>
                        <Separator Margin="0,13"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Valor original" Foreground="#78847E"/><TextBlock x:Name="SelectedOriginalText" Text="R$ 0,00" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Total pago" Foreground="#78847E"/><TextBlock x:Name="SelectedPaidText" Text="R$ 0,00" FontSize="20" FontWeight="SemiBold" Foreground="#16803B"/></StackPanel>
                        </Grid>
                        <Border Background="#FFF2F2" CornerRadius="8" Padding="12" Margin="0,14,0,10">
                            <StackPanel><TextBlock Text="SALDO EM ABERTO" Foreground="#A23B3B" FontWeight="SemiBold"/><TextBlock x:Name="SelectedBalanceText" Text="R$ 0,00" FontSize="34" FontWeight="Bold" Foreground="#D21F26" TextAlignment="Right"/></StackPanel>
                        </Border>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Vencimento" Foreground="#78847E"/><TextBlock x:Name="SelectedDueText" Text="—" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Status" Foreground="#78847E"/><TextBlock x:Name="SelectedStatusText" Text="—" FontWeight="SemiBold"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#EEF5FF" BorderBrush="#D6E3F4" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="LIMITE" Foreground="#57708A"/><TextBlock x:Name="CreditLimitText" Text="R$ 0,00" FontSize="20" FontWeight="Bold"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="DISPONÍVEL" Foreground="#57708A"/><TextBlock x:Name="CreditAvailableText" Text="R$ 0,00" FontSize="20" FontWeight="Bold" Foreground="#1767B0"/></StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="CreditBlockedText" Text="" Foreground="#B3261E" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <Button Style="{StaticResource SoftButton}" Content="ALTERAR LIMITE" Click="CreditLimit_Click" Padding="10,7"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#EEF8F1" BorderBrush="#D5E9DA" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="RECEBER PAGAMENTO" FontSize="17" FontWeight="Bold" Foreground="#0A6B38" Margin="2,0,0,6"/>
                        <TextBlock Text="Dinheiro, PIX, débito ou crédito. O saldo é atualizado automaticamente e o recebimento fica auditado." TextWrapping="Wrap" Foreground="#596961" Margin="2,0,2,10"/>
                        <Button Style="{StaticResource RoundedButton}" Content="💵  RECEBER PAGAMENTO  [F9]" FontSize="17" Click="Receive_Click"/>
                        <Button Style="{StaticResource SoftButton}" Content="🧾  GERAR / VER EXTRATO PDF" Click="Pdf_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Selecione uma conta para ver detalhes, receber e imprimir o extrato." Foreground="#75827B" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="FECHAR" IsCancel="True" Width="120"/>
        </Grid>
    </Grid>
</Window>
