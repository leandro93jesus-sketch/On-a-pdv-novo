<Window x:Class="OncaPDV.Desktop.CreditLimitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limite de Crediário" Width="500" Height="470" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F9F8">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="LIMITE DE CREDIÁRIO" FontSize="24" FontWeight="Bold" Foreground="#173D29"/>
            <TextBlock x:Name="CustomerText" FontSize="17" Foreground="#5D6B63" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <UniformGrid Columns="2">
                <Border Background="#FFF2F2" CornerRadius="8" Padding="12" Margin="3"><StackPanel><TextBlock Text="SALDO EM ABERTO"/><TextBlock x:Name="OpenText" FontSize="22" FontWeight="Bold" Foreground="#C62828"/></StackPanel></Border>
                <Border Background="#EAF7EE" CornerRadius="8" Padding="12" Margin="3"><StackPanel><TextBlock Text="DISPONÍVEL"/><TextBlock x:Name="AvailableText" FontSize="22" FontWeight="Bold" Foreground="#0B6B3A"/></StackPanel></Border>
            </UniformGrid>
            <TextBlock Text="Novo limite (R$)" FontWeight="SemiBold" Margin="3,14,0,0"/>
            <TextBox x:Name="LimitBox" FontSize="24" Padding="9" Margin="3,4,3,12"/>
            <CheckBox x:Name="BlockedBox" Content="Bloquear novas vendas no crediário" FontWeight="SemiBold" Margin="3,0,0,12"/>
            <TextBlock Text="Observação"/><TextBox x:Name="NotesBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Margin="3,4,3,0"/>
            <TextBlock x:Name="StatusText" Foreground="#A3392F" Margin="3,10,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCELAR" IsCancel="True" Padding="14,9" Margin="4"/>
            <Button Content="SALVAR LIMITE" Click="Save_Click" Background="#0B6B3A" Foreground="White" FontWeight="Bold" Padding="16,9" Margin="4"/>
        </StackPanel>
    </Grid>
</Window>