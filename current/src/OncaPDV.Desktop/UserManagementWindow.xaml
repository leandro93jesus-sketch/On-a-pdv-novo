<Window x:Class="OncaPDV.Desktop.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuários e Permissões" Width="820" Height="560" WindowStartupLocation="CenterOwner" Background="#F7F9F8">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="USUÁRIOS E PERMISSÕES" FontSize="26" FontWeight="Bold" Foreground="#173D29"/><TextBlock Text="Controle quem pode vender, mexer no estoque ou executar ações administrativas." Foreground="#6B7972"/></StackPanel>
            <Button Grid.Column="1" Content="+ NOVO USUÁRIO" Click="New_Click" Background="#0B6B3A" Foreground="White" FontWeight="Bold" Padding="15,10"/>
        </Grid>
        <DataGrid Grid.Row="1" x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,16,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NOME" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="USUÁRIO" Binding="{Binding Username}" Width="180"/>
                <DataGridTextColumn Header="PERFIL" Binding="{Binding Role}" Width="140"/>
                <DataGridCheckBoxColumn Header="ATIVO" Binding="{Binding Active}" Width="80"/>
                <DataGridCheckBoxColumn Header="TROCAR PIN" Binding="{Binding MustChangePin}" Width="95"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="EDITAR SELECIONADO" Click="Edit_Click" Padding="14,9" Margin="4"/>
            <Button Content="FECHAR" IsCancel="True" Padding="14,9" Margin="4"/>
        </StackPanel>
    </Grid>
</Window>