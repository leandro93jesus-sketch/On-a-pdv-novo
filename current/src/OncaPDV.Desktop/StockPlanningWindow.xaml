<Window x:Class="OncaPDV.Desktop.StockPlanningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reposição e Produtos sem Giro" Width="1180" Height="700" WindowStartupLocation="CenterOwner" Background="#F7F9F8">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PLANEJAMENTO DE ESTOQUE" FontSize="26" FontWeight="Bold" Foreground="#173D29"/>
            <TextBlock Text="Sugestão de compra, custo médio e itens sem giro." Foreground="#6B7972"/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,12">
            <Border Background="#FFF6E8" CornerRadius="9" Padding="12" Margin="3"><StackPanel><TextBlock Text="PRECISAM COMPRAR"/><TextBlock x:Name="BuyCountText" FontSize="26" FontWeight="Bold" Foreground="#B56A00"/></StackPanel></Border>
            <Border Background="#FFF0F0" CornerRadius="9" Padding="12" Margin="3"><StackPanel><TextBlock Text="SEM GIRO"/><TextBlock x:Name="NoMovementCountText" FontSize="26" FontWeight="Bold" Foreground="#B42318"/></StackPanel></Border>
            <Border Background="#EAF7EE" CornerRadius="9" Padding="12" Margin="3"><StackPanel><TextBlock Text="CUSTO ESTIMADO DA REPOSIÇÃO"/><TextBlock x:Name="EstimatedCostText" FontSize="26" FontWeight="Bold" Foreground="#0B6B3A"/></StackPanel></Border>
        </UniformGrid>
        <DataGrid Grid.Row="2" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="AÇÃO" Binding="{Binding Action}" Width="95"/>
                <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Code}" Width="100"/>
                <DataGridTextColumn Header="PRODUTO" Binding="{Binding Product}" Width="*"/>
                <DataGridTextColumn Header="FORNECEDOR" Binding="{Binding Supplier}" Width="180"/>
                <DataGridTextColumn Header="ESTOQUE" Binding="{Binding Stock,StringFormat=N3}" Width="85"/>
                <DataGridTextColumn Header="MÍN." Binding="{Binding Minimum,StringFormat=N3}" Width="75"/>
                <DataGridTextColumn Header="COMPRAR" Binding="{Binding SuggestedBuy,StringFormat=N3}" Width="90"/>
                <DataGridTextColumn Header="CUSTO ATUAL" Binding="{Binding CurrentCost,StringFormat=C}" Width="105"/>
                <DataGridTextColumn Header="CUSTO MÉDIO" Binding="{Binding AverageCost,StringFormat=C}" Width="105"/>
                <DataGridTextColumn Header="DIAS SEM VENDA" Binding="{Binding DaysWithoutSale}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="GERAR PDF" Click="Pdf_Click" Padding="14,9" Margin="4" Background="#0B6B3A" Foreground="White" FontWeight="Bold"/>
            <Button Content="FECHAR" IsCancel="True" Padding="14,9" Margin="4"/>
        </StackPanel>
    </Grid>
</Window>