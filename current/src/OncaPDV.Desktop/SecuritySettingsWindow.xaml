<Window x:Class="OncaPDV.Desktop.SecuritySettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Usuários, Permissões e Backup" Width="980" Height="690" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F7F9F8" FontFamily="Segoe UI">
<Window.Resources>
<Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#0B6B3A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style x:Key="Soft" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#EDF2EF"/><Setter Property="Foreground" Value="#26342E"/></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
</Window.Resources>
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="USUÁRIOS, PERMISSÕES E BACKUP" FontSize="27" FontWeight="Bold" Foreground="#173D29"/><TextBlock Text="Administrador controla ações críticas. Caixa vende/recebe. Estoquista gerencia produtos e estoque." Foreground="#68776F" Margin="0,4,0,14"/></StackPanel>
<TabControl Grid.Row="1">
<TabItem Header="Usuários e permissões"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
<DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="NOME" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PERFIL" Binding="{Binding Role}" Width="150"/><DataGridCheckBoxColumn Header="ATIVO" Binding="{Binding Active}" Width="80"/></DataGrid.Columns></DataGrid>
<Border Grid.Column="1" Background="White" BorderBrush="#DDE5E1" BorderThickness="1" CornerRadius="10" Padding="16" Margin="14,0,0,0"><StackPanel><TextBlock Text="NOVO USUÁRIO" FontSize="18" FontWeight="Bold" Foreground="#173D29"/><TextBlock Text="Nome"/><TextBox x:Name="UserName"/><TextBlock Text="Perfil"/><ComboBox x:Name="UserRole"><ComboBoxItem Content="Administrador" Tag="Administrator"/><ComboBoxItem Content="Caixa" Tag="Cashier" IsSelected="True"/><ComboBoxItem Content="Estoquista" Tag="Stockkeeper"/></ComboBox><TextBlock Text="PIN"/><PasswordBox x:Name="UserPin" Padding="10,8" FontSize="16" Margin="0,4,0,10"/><Button Style="{StaticResource Primary}" Content="ADICIONAR USUÁRIO" Click="AddUser_Click"/><Separator Margin="0,12"/><Button Style="{StaticResource Soft}" Content="DEFINIR COMO USUÁRIO ATUAL" Click="SetActive_Click"/><Button Style="{StaticResource Soft}" Content="ALTERAR PIN DO SELECIONADO" Click="ChangePin_Click"/><Button Style="{StaticResource Soft}" Content="ATIVAR / DESATIVAR" Click="ToggleUser_Click"/></StackPanel></Border>
</Grid></TabItem>
<TabItem Header="Backup automático"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><CheckBox x:Name="BackupEnabled" Content="Ativar backup automático diário" FontSize="17" FontWeight="SemiBold"/>
<Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Pasta externa / pendrive (opcional)"/><TextBox x:Name="ExternalFolder" ToolTip="Ex.: E:\Backup Onça ou D:\Backup Onça"/></StackPanel><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Avisar após quantas horas sem backup"/><TextBox x:Name="WarnHours"/></StackPanel></Grid>
<Border Grid.Row="2" Background="#FFF8E8" BorderBrush="#F0DFB3" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,14,0,0"><TextBlock Text="O sistema cria o backup local automaticamente e, quando uma pasta externa estiver configurada, copia o mesmo arquivo para ela. Se a pasta externa estiver indisponível, a venda continua funcionando e o aviso aparece no sistema." TextWrapping="Wrap" Foreground="#755B17"/></Border>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Style="{StaticResource Soft}" Content="TESTAR / FAZER BACKUP AGORA" Click="BackupNow_Click"/><Button Style="{StaticResource Primary}" Content="SALVAR CONFIGURAÇÃO" Click="SaveBackup_Click"/></StackPanel></Grid></TabItem>
</TabControl>
<Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Foreground="#5E6D65" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource Soft}" Content="FECHAR" IsCancel="True"/></Grid>
</Grid></Window>