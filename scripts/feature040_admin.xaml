<Window x:Class="OncaPDV.Desktop.AdminAuthorization040Window" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Autorização de administrador — ONÇA PDV PRO" Width="440" Height="350" MinWidth="420" MinHeight="320" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F9F8">
<Grid Margin="20">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="19" FontWeight="Bold" Foreground="#0B6B3A" TextWrapping="Wrap" Text="AUTORIZAÇÃO DE ADMINISTRADOR" Margin="0,0,0,14"/>
<TextBlock x:Name="NameLabel" Grid.Row="1" Text="Nome do responsável:" FontWeight="SemiBold" Margin="0,2,0,4"/>
<TextBox x:Name="AdminNameBox" Grid.Row="2" Padding="8" MaxLength="80" Margin="0,0,0,10"/>
<TextBlock Grid.Row="3" Text="PIN de administrador (6 a 12 números):" FontWeight="SemiBold" Margin="0,0,0,4"/>
<PasswordBox x:Name="PinBox" Grid.Row="4" Padding="8" MaxLength="12"/>
<StackPanel Grid.Row="5" x:Name="ConfirmPanel" Margin="0,8,0,0"><TextBlock Text="Confirme o PIN (somente no primeiro cadastro):" FontWeight="SemiBold" Margin="0,0,0,4"/><PasswordBox x:Name="ConfirmBox" Padding="8" MaxLength="12"/></StackPanel>
<StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
<Button Content="CANCELAR" Click="Cancel_Click" Padding="16,9" Margin="4"/>
<Button Content="AUTORIZAR" Click="Authorize_Click" Padding="16,9" Background="#0B6B3A" Foreground="White" FontWeight="Bold" Margin="4"/>
</StackPanel></Grid>
</Window>