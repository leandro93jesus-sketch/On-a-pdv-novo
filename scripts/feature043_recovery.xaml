<Window x:Class="OncaPDV.Desktop.AdminRecovery043Window" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ONÇA PDV 0.1.43 — RECUPERAR PIN" Width="510" Height="405" MinWidth="485" MinHeight="375" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F9F8">
<Grid Margin="20">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Foreground="#0B6B3A" Text="RECUPERAR ACESSO DE ADMINISTRADOR" Margin="0,0,0,10" TextWrapping="Wrap"/>
<TextBlock Grid.Row="1" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,13" Text="Atualização de recuperação: substitua o PIN anterior por um novo, sem precisar informar a senha antiga. A operação é executada apenas uma vez e não modifica produtos, vendas ou estoque."/>
<TextBlock Grid.Row="2" Text="Responsável:" FontWeight="SemiBold" Margin="0,0,0,5"/>
<TextBox x:Name="AdminNameBox" Grid.Row="3" Padding="9" Text="Leandro" MaxLength="80" Margin="0,0,0,10"/>
<TextBlock Grid.Row="4" Text="Digite o novo PIN (6 a 12 números):" FontWeight="SemiBold" Margin="0,0,0,5"/>
<PasswordBox x:Name="PinBox" Grid.Row="5" Padding="9" MaxLength="12" Margin="0,0,0,10"/>
<StackPanel Grid.Row="6"><TextBlock Text="Repita o novo PIN:" FontWeight="SemiBold" Margin="0,0,0,5"/><PasswordBox x:Name="ConfirmBox" Padding="9" MaxLength="12"/></StackPanel>
<StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
<Button Content="FAZER DEPOIS" Padding="15,10" Margin="4" Click="Later_Click"/>
<Button Content="CONFIRMAR E RECUPERAR ACESSO" Padding="15,10" Margin="4" Background="#0B6B3A" Foreground="White" FontWeight="Bold" Click="Save_Click"/>
</StackPanel>
</Grid></Window>