<Window x:Class="OncaPDV.Desktop.AdminPinSetup042Window" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ONÇA PDV — Redefinição única do PIN" Width="490" Height="390" MinWidth="460" MinHeight="350" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F9F8">
<Grid Margin="20">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Foreground="#0B6B3A" Text="CONFIGURAR NOVO PIN" Margin="0,0,0,7"/>
<TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="13" Text="Atualização de segurança: escolha seu PIN de 6 a 12 números. Esta etapa substitui qualquer PIN anterior uma única vez, sem modificar vendas, estoque ou produtos." Margin="0,0,0,14"/>
<TextBlock Grid.Row="2" Text="Nome do administrador:" FontWeight="SemiBold" Margin="0,0,0,5"/>
<TextBox x:Name="AdminNameBox" Grid.Row="3" Padding="9" MaxLength="80" Text="Leandro" Margin="0,0,0,11"/>
<TextBlock Grid.Row="4" Text="Novo PIN:" FontWeight="SemiBold" Margin="0,0,0,5"/>
<PasswordBox x:Name="PinBox" Grid.Row="5" Padding="9" MaxLength="12" Margin="0,0,0,11"/>
<StackPanel Grid.Row="6"><TextBlock Text="Repita o novo PIN:" FontWeight="SemiBold" Margin="0,0,0,5"/><PasswordBox x:Name="ConfirmBox" Padding="9" MaxLength="12"/></StackPanel>
<StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
<Button Content="DEPOIS" Padding="17,10" Margin="4" Click="Later_Click"/>
<Button Content="SALVAR NOVO PIN" Padding="18,10" Margin="4" Background="#0B6B3A" Foreground="White" FontWeight="Bold" Click="Save_Click"/>
</StackPanel>
</Grid></Window>